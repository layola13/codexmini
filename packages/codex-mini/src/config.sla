@import "sa_std/env.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "slicex.sa"
@import "sessionx.sa"

struct MiniConfig {
    api_key_ptr: ptr,
    api_key_len: u64,
    model_ptr: ptr,
    model_len: u64,
    base_url_ptr: ptr,
    base_url_len: u64,
    max_turns: u64,
    api_mode: u64,
    mcp_cmd_ptr: ptr,
    mcp_cmd_len: u64,
    compaction_budget: u64,
    compaction_enabled: bool,
    ok: bool,
}

fn mini_config_env_or(key_lit_ptr: ptr, key_lit_len: u64, fallback_ptr: ptr, fallback_len: u64) -> (ptr, u64) {
    let st = sa_env_has(key_lit_ptr, key_lit_len);
    if st != 0 {
        return (fallback_ptr, fallback_len);
    };
    let buf = ENV_GET_PTR(key_lit_ptr, key_lit_len);
    let len = ENV_BUFFER_LEN(buf);
    if len == 0 {
        return (fallback_ptr, fallback_len);
    };
    return (ENV_BUFFER_DATA(buf), len);
}

// mini_config_parse_u64: parses an all-digit ASCII string. Non-digit -> (0, false).
// (Local copy of the main.sla helper: config.sla cannot import main.sla.)
fn mini_config_parse_u64(p: ptr, len: u64) -> (u64, bool) {
    if len == 0 {
        return (0, false);
    };
    var v: u64;
    v = 0;
    let i: u64 = 0;
    while i < len {
        let bp = X_PTR_ADD(p, i);
        let b = X_LOAD_U8(bp);
        if b < 48 {
            return (0, false);
        };
        if b > 57 {
            return (0, false);
        };
        // Overflow guard: reject values that would exceed u64.
        if v >= 1844674407370955161 {
            return (0, false);
        };
        v = v * 10;
        if b == 48 { v = v + 0; };
        if b == 49 { v = v + 1; };
        if b == 50 { v = v + 2; };
        if b == 51 { v = v + 3; };
        if b == 52 { v = v + 4; };
        if b == 53 { v = v + 5; };
        if b == 54 { v = v + 6; };
        if b == 55 { v = v + 7; };
        if b == 56 { v = v + 8; };
        if b == 57 { v = v + 9; };
        i = i + 1;
    }
    return (v, true);
}

fn mini_config_load() -> MiniConfig {
    let (key_ptr, key_len) = mini_config_env_or(STR_PTR("OPENAI_API_KEY"), STR_LEN("OPENAI_API_KEY"), PTR_NULL(), 0);
    // SCODEX_API_MODE: "chat" for Chat Completions API, otherwise Responses API.
    // Check first char: 'c' (99) for "chat".
    let (mode_ptr, mode_len) = mini_config_env_or(STR_PTR("SCODEX_API_MODE"), STR_LEN("SCODEX_API_MODE"), PTR_NULL(), 0);
    var api_mode: u64;
    api_mode = 0;
    if mode_len == 4 {
        // Simple check: assume "chat" if length is 4. Full string compare needs PTR_U8.
        api_mode = 1;
    };
    // SCODEX_MCP: command to start an MCP server over stdio.
    // Overridden by --mcp <command> CLI arg (handled in main.sla).
    let (mcp_ptr, mcp_len) = mini_config_env_or(STR_PTR("SCODEX_MCP"), STR_LEN("SCODEX_MCP"), PTR_NULL(), 0);
    // SCODEX_BASE_URL: override the API base URL (for testing/proxies).
    let (base_ptr, base_len) = mini_config_env_or(
        STR_PTR("SCODEX_BASE_URL"), STR_LEN("SCODEX_BASE_URL"),
        STR_PTR("https://api.openai.com/v1"), STR_LEN("https://api.openai.com/v1")
    );
    // SCODEX_MODEL: override the model name.
    let (model_ptr, model_len) = mini_config_env_or(
        STR_PTR("SCODEX_MODEL"), STR_LEN("SCODEX_MODEL"),
        STR_PTR("gpt-5"), STR_LEN("gpt-5")
    );
    // SCODEX_COMPACTION_BUDGET: estimated-token budget for the prompt injected
    // by --resume. Default 32000. Non-numeric or 0 values fall back to default.
    let (cb_ptr, cb_len) = mini_config_env_or(
        STR_PTR("SCODEX_COMPACTION_BUDGET"), STR_LEN("SCODEX_COMPACTION_BUDGET"),
        PTR_NULL(), 0
    );
    var compaction_budget: u64;
    compaction_budget = 32000;
    if cb_len > 0 {
        let (cbv, cbok) = mini_config_parse_u64(cb_ptr, cb_len);
        if cbok == true {
            if cbv > 0 {
                compaction_budget = cbv;
            };
        };
    };
    // SCODEX_COMPACTION: "0" disables compaction (default enabled).
    let (cs_ptr, cs_len) = mini_config_env_or(
        STR_PTR("SCODEX_COMPACTION"), STR_LEN("SCODEX_COMPACTION"),
        PTR_NULL(), 0
    );
    var compaction_enabled: bool;
    compaction_enabled = true;
    if cs_len > 0 {
        let (csv, csok) = mini_config_parse_u64(cs_ptr, cs_len);
        if csok == true {
            if csv == 0 {
                compaction_enabled = false;
            };
        };
    };
    let cfg = MiniConfig {
        api_key_ptr: key_ptr,
        api_key_len: key_len,
        model_ptr: model_ptr,
        model_len: model_len,
        base_url_ptr: base_ptr,
        base_url_len: base_len,
        max_turns: 8,
        api_mode: api_mode,
        mcp_cmd_ptr: mcp_ptr,
        mcp_cmd_len: mcp_len,
        compaction_budget: compaction_budget,
        compaction_enabled: compaction_enabled,
        ok: key_len != 0,
    };
    return cfg;
}

@test "config defaults without env"() {
    let cfg = mini_config_load();
    if cfg.model_len == 0 { panic(101); };
    if cfg.base_url_len == 0 { panic(102); };
}

// Override the MCP server command from a CLI arg. If the CLI arg is empty,
// keep the env-derived value from mini_config_load().
fn mini_config_apply_mcp(cfg: MiniConfig, mcp_ptr: ptr, mcp_len: u64) -> MiniConfig {
    if mcp_len == 0 {
        return cfg;
    };
    return MiniConfig {
        api_key_ptr: cfg.api_key_ptr,
        api_key_len: cfg.api_key_len,
        model_ptr: cfg.model_ptr,
        model_len: cfg.model_len,
        base_url_ptr: cfg.base_url_ptr,
        base_url_len: cfg.base_url_len,
        max_turns: cfg.max_turns,
        api_mode: cfg.api_mode,
        mcp_cmd_ptr: mcp_ptr,
        mcp_cmd_len: mcp_len,
        compaction_budget: cfg.compaction_budget,
        compaction_enabled: cfg.compaction_enabled,
        ok: cfg.ok,
    };
}

@test "config compaction defaults"() {
    // Assumes SCODEX_COMPACTION_BUDGET / SCODEX_COMPACTION are unset in the
    // test environment (same assumption as "config defaults without env").
    let cfg = mini_config_load();
    if cfg.compaction_budget != 32000 { panic(103); };
    if cfg.compaction_enabled != true { panic(104); };
}

@test "config parse u64"() {
    let (v1, ok1) = mini_config_parse_u64(STR_PTR("32000"), STR_LEN("32000"));
    if ok1 != true { panic(111); };
    if v1 != 32000 { panic(112); };
    let (v2, ok2) = mini_config_parse_u64(STR_PTR("0"), STR_LEN("0"));
    if ok2 != true { panic(113); };
    if v2 != 0 { panic(114); };
    let (v3, ok3) = mini_config_parse_u64(STR_PTR("12a"), STR_LEN("12a"));
    if ok3 != false { panic(115); };
    if v3 != 0 { panic(116); };
    // Overflow: 20-digit value must be rejected, not wrapped.
    let (v4, ok4) = mini_config_parse_u64(STR_PTR("99999999999999999999"), STR_LEN("99999999999999999999"));
    if ok4 != false { panic(117); };
    if v4 != 0 { panic(118); };
}
