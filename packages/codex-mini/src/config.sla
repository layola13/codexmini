@import "sa_std/env.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/vec.sa"
@import "slicex.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/io/print.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/encoding/json.sa"
@import "jsonx.sa"
@import "sa_std/fs.sa"
@import "mcp.sla"
@import "config_layers.sla"

struct MiniConfig {
    api_key_ptr: ptr,
    api_key_len: u64,
    model_ptr: ptr,
    model_len: u64,
    base_url_ptr: ptr,
    base_url_len: u64,
    max_turns: u64,
    api_mode: u64,
    mcp_servers: Vec<MiniMcpServer>,
    ok: bool,
}

fn mini_config_env_or(key_lit_ptr: ptr, key_lit_len: u64, fallback_ptr: ptr, fallback_len: u64) -> (ptr, u64) {
    let st = sa_env_has(key_lit_ptr, key_lit_len);
    if st != 0 {
        return (fallback_ptr, fallback_len);
    };
    let buf = ENV_GET_PTR(key_lit_ptr, key_lit_len);
    let len = ENV_BUFFER_LEN(buf);
    if len == 0 {
        return (fallback_ptr, fallback_len);
    };
    return (ENV_BUFFER_DATA(buf), len);
}

// mini_config_servers_from_json: parse {"name": {"command","args","env"}}
// into the registry vec. Takes ownership of the vec and returns the updated
// vec (linear threading: the caller's vec is moved in, pushes are preserved).
// Malformed entries are skipped with an explicit warning
// (never silently misconfigured).
fn mini_config_servers_from_json(
    servers: Vec<MiniMcpServer>,
    obj_node: ptr,
) -> Vec<MiniMcpServer> {
    var added: u64;
    added = 0;
    var ki: u64;
    ki = 0;
    var done: u64;
    done = 0;
    while done == 0 {
        let kptr: ptr = PTR_NULL();
        let klen: u64 = 0;
        let kst = sa_json_object_key_at(obj_node, ki, &kptr, &klen);
        if kst != 0 {
            done = 1;
        } else {
            let srv_node: ptr = PTR_NULL();
            let gst = sa_json_object_get(obj_node, kptr, klen, &srv_node);
            if gst != 0 {
                println("scodex-mini: mcp config: cannot read server entry, skipped");
            } else {
                let is_obj: bool = false;
                JSON_IS_OBJECT(is_obj, srv_node);
                if is_obj != true {
                    println("scodex-mini: mcp config: server entry must be an object, skipped");
                } else {
                    let (cmd_ptr, cmd_len, cmd_ok) = mini_mcp_build_server_cmd(srv_node);
                    if cmd_ok == true {
                        // copy the name: it points into the config JSON buffer
                        let nbuf = X_HEAP_BUF_PTR(klen);
                        X_COPY_BYTES(nbuf, kptr, klen);
                        let srv = mini_mcp_server_new(nbuf, klen, cmd_ptr, cmd_len);
                        servers.push(srv);
                        added = added + 1;
                    };
                    // (a warning was already printed by the builder on failure)
                };
            };
            ki = ki + 1;
        };
    }
    return servers;
}

// mini_config_mcp_stage_env: source 1, SCODEX_MCP_SERVERS env (JSON object,
// same shape as the config file). Takes ownership of the registry vec and
// returns the updated vec.
fn mini_config_mcp_stage_env(servers: Vec<MiniMcpServer>) -> Vec<MiniMcpServer> {
    let (se_ptr, se_len) = mini_config_env_or(
        STR_PTR("SCODEX_MCP_SERVERS"), STR_LEN("SCODEX_MCP_SERVERS"), PTR_NULL(), 0);
    if se_len == 0 {
        return servers;
    };
    let se_root = JSON_PARSE(se_ptr, se_len);
    let se_is_obj: bool = false;
    JSON_IS_OBJECT(se_is_obj, se_root);
    if se_is_obj == true {
        return mini_config_servers_from_json(servers, se_root);
    };
    println("scodex-mini: SCODEX_MCP_SERVERS must be a JSON object, ignored");
    return servers;
}

// mini_config_mcp_stage_file: source 2, <config file> "mcp_servers" object.
// Takes ownership of the registry vec and returns the updated vec.
fn mini_config_mcp_stage_file(servers: Vec<MiniMcpServer>) -> Vec<MiniMcpServer> {
    let (cfg_path_ptr, cfg_path_len) = mini_config_path();
    if cfg_path_len == 0 {
        return servers;
    };
    let fbuf: u64 = 0;
    let fst = sa_std_fs_read_to_string(cfg_path_ptr, cfg_path_len, 1048576, &fbuf);
    if fst != 0 {
        return servers;
    };
    let flen = sa_fs_read_buffer_len(fbuf);
    if flen == 0 {
        return servers;
    };
    let fref = sa_fs_read_buffer_data(fbuf);
    let fptr: ptr = fref;
    let froot = JSON_PARSE(fptr, flen);
    let has_ms: bool = false;
    X_OBJ_HAS(has_ms, froot, STR_PTR("mcp_servers"), STR_LEN("mcp_servers"));
    if has_ms != true {
        return servers;
    };
    let ms_node: ptr = PTR_NULL();
    let mst = sa_json_object_get(froot,
        STR_PTR("mcp_servers"), STR_LEN("mcp_servers"), &ms_node);
    if mst != 0 {
        return servers;
    };
    let ms_is_obj: bool = false;
    JSON_IS_OBJECT(ms_is_obj, ms_node);
    if ms_is_obj == true {
        return mini_config_servers_from_json(servers, ms_node);
    };
    println("scodex-mini: config: \"mcp_servers\" must be an object, ignored");
    return servers;
}

// mini_config_mcp_stage_legacy: source 3, SCODEX_MCP env (single legacy
// server, registered as "default"). Takes ownership of the registry vec and
// returns the updated vec.
fn mini_config_mcp_stage_legacy(servers: Vec<MiniMcpServer>) -> Vec<MiniMcpServer> {
    let (mcp_ptr, mcp_len) = mini_config_env_or(STR_PTR("SCODEX_MCP"), STR_LEN("SCODEX_MCP"), PTR_NULL(), 0);
    if mcp_len == 0 {
        return servers;
    };
    let nbuf = X_HEAP_BUF_PTR(STR_LEN("default"));
    X_COPY_BYTES(nbuf, STR_PTR("default"), STR_LEN("default"));
    let cbuf = X_HEAP_BUF_PTR(mcp_len);
    X_COPY_BYTES(cbuf, mcp_ptr, mcp_len);
    let srv = mini_mcp_server_new(nbuf, STR_LEN("default"), cbuf, mcp_len);
    servers.push(srv);
    return servers;
}

// mini_config_load_mcp_servers: build the MCP server registry.
// Sources, in order:
//   1. SCODEX_MCP_SERVERS env (JSON object, same shape as the config file)
//   2. <config file> "mcp_servers" object
//   3. SCODEX_MCP env (single legacy server, registered as "default")
// The registry vec is threaded linearly through the stages: each stage takes
// ownership and returns the updated vec, so no use-after-move is possible.
fn mini_config_load_mcp_servers() -> Vec<MiniMcpServer> {
    let s0: Vec<MiniMcpServer> = Vec::new();
    let s1 = mini_config_mcp_stage_env(s0);
    let s2 = mini_config_mcp_stage_file(s1);
    let s3 = mini_config_mcp_stage_legacy(s2);
    return s3;
}

// mini_config_path: SCODEX_CONFIG env, else $HOME/.scodex-mini/config.json.
fn mini_config_path() -> (ptr, u64) {
    let (ep, el) = mini_config_env_or(STR_PTR("SCODEX_CONFIG"), STR_LEN("SCODEX_CONFIG"), PTR_NULL(), 0);
    if el > 0 {
        return (ep, el);
    };
    let (hp, hl) = mini_config_env_or(STR_PTR("HOME"), STR_LEN("HOME"), PTR_NULL(), 0);
    if hl == 0 {
        return (PTR_NULL(), 0);
    };
    let total = hl + STR_LEN("/.scodex-mini/config.json");
    let buf = X_HEAP_BUF_PTR(total);
    X_COPY_BYTES(buf, hp, hl);
    X_COPY_BYTES(X_PTR_ADD(buf, hl), STR_PTR("/.scodex-mini/config.json"), STR_LEN("/.scodex-mini/config.json"));
    return (buf, total);
}

fn mini_config_load() -> MiniConfig {
    // Default: read profile from SCODEX_PROFILE env.
    let (pp, pl) = mini_config_env_or(
        STR_PTR("SCODEX_PROFILE"), STR_LEN("SCODEX_PROFILE"), PTR_NULL(), 0);
    return mini_config_load_with_profile(pp, pl);
}

// mini_config_load_with_profile: layered TOML config (codex-style, our paths).
// Layers: system -> user -> project -> profile. SCODEX_* env vars override
// everything (highest precedence, backward compatible).
fn mini_config_load_with_profile(profile_ptr: ptr, profile_len: u64) -> MiniConfig {
    // 1. Load layered TOML config.
    let entries = config_layers_merged(profile_ptr, profile_len);

    // 2. Extract values from TOML layers (env vars override below).
    let (tm_model_ptr, tm_model_len, tm_model_ok) = layer_get_str(entries,
        STR_PTR("model"), STR_LEN("model"));
    let (tm_mode_ptr, tm_mode_len, tm_mode_ok) = layer_get_str(entries,
        STR_PTR("api_mode"), STR_LEN("api_mode"));
    var tm_api_mode: u64;
    tm_api_mode = 0;
    if tm_mode_ok == true {
        let is_chat = false;
        X_STR_EQ(is_chat, tm_mode_ptr, tm_mode_len,
            STR_PTR("chat"), STR_LEN("chat"));
        if is_chat == true {
            tm_api_mode = 1;
        };
    };
    let (tm_base_ptr, tm_base_len, tm_base_ok) = layer_get_str(entries,
        STR_PTR("base_url"), STR_LEN("base_url"));
    let (tm_turns, tm_turns_ok) = layer_get_u64(entries,
        STR_PTR("max_turns"), STR_LEN("max_turns"));

    // 3. Env vars override TOML (backward compatible).
    let (key_ptr, key_len) = mini_config_env_or(STR_PTR("OPENAI_API_KEY"), STR_LEN("OPENAI_API_KEY"), PTR_NULL(), 0);
    let (mode_ptr, mode_len) = mini_config_env_or(STR_PTR("SCODEX_API_MODE"), STR_LEN("SCODEX_API_MODE"), PTR_NULL(), 0);
    var api_mode: u64;
    api_mode = tm_api_mode;
    if mode_len == 4 {
        api_mode = 1;
    } else {
        if mode_len > 0 {
            api_mode = 0;
        };
    };
    let servers = mini_config_load_mcp_servers();
    let (env_base_ptr, env_base_len) = mini_config_env_or(
        STR_PTR("SCODEX_BASE_URL"), STR_LEN("SCODEX_BASE_URL"), PTR_NULL(), 0);
    let base_ptr: ptr = tm_base_ptr;
    let base_len: u64 = tm_base_len;
    if env_base_len > 0 {
        base_ptr = env_base_ptr;
        base_len = env_base_len;
    } else {
        if tm_base_ok == false {
            base_ptr = STR_PTR("https://api.openai.com/v1");
            base_len = STR_LEN("https://api.openai.com/v1");
        };
    };
    let (env_model_ptr, env_model_len) = mini_config_env_or(
        STR_PTR("SCODEX_MODEL"), STR_LEN("SCODEX_MODEL"), PTR_NULL(), 0);
    let model_ptr: ptr = tm_model_ptr;
    let model_len: u64 = tm_model_len;
    if env_model_len > 0 {
        model_ptr = env_model_ptr;
        model_len = env_model_len;
    } else {
        if tm_model_ok == false {
            model_ptr = STR_PTR("gpt-5");
            model_len = STR_LEN("gpt-5");
        };
    };
    var max_turns: u64;
    max_turns = 8;
    if tm_turns_ok == true {
        max_turns = tm_turns;
    };
    let cfg = MiniConfig {
        api_key_ptr: key_ptr,
        api_key_len: key_len,
        model_ptr: model_ptr,
        model_len: model_len,
        base_url_ptr: base_ptr,
        base_url_len: base_len,
        max_turns: max_turns,
        api_mode: api_mode,
        mcp_servers: servers,
        ok: key_len != 0,
    };
    return cfg;
}

@test "config defaults without env"() {
    let cfg = mini_config_load();
    if cfg.model_len == 0 { panic(101); };
    if cfg.base_url_len == 0 { panic(102); };
}

// Override the MCP server list from a --mcp <command> CLI arg: registers a
// single legacy server named "default". Empty arg keeps config/env values.
fn mini_config_apply_mcp(cfg: MiniConfig, mcp_ptr: ptr, mcp_len: u64) -> MiniConfig {
    if mcp_len == 0 {
        return cfg;
    };
    let servers: Vec<MiniMcpServer> = Vec::new();
    let nbuf = X_HEAP_BUF_PTR(STR_LEN("default"));
    X_COPY_BYTES(nbuf, STR_PTR("default"), STR_LEN("default"));
    let cbuf = X_HEAP_BUF_PTR(mcp_len);
    X_COPY_BYTES(cbuf, mcp_ptr, mcp_len);
    let srv = mini_mcp_server_new(nbuf, STR_LEN("default"), cbuf, mcp_len);
    servers.push(srv);
    return MiniConfig {
        api_key_ptr: cfg.api_key_ptr,
        api_key_len: cfg.api_key_len,
        model_ptr: cfg.model_ptr,
        model_len: cfg.model_len,
        base_url_ptr: cfg.base_url_ptr,
        base_url_len: cfg.base_url_len,
        max_turns: cfg.max_turns,
        api_mode: cfg.api_mode,
        mcp_servers: servers,
        ok: cfg.ok,
    };
}
