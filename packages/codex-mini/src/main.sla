@import "sa_std/env.sa"
@import "sa_std/encoding/json.sa"
@import "jsonx.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/vec.sa"
@import "slicex.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/io/print.sai"
@import "config.sla"
@import "model.sla"
@import "image.sla"
@import "sandbox.sla"
@import "tools.sla"


// mini_cli_arg(idx): argv[idx] as (ptr, len, ok). ok=false when missing,
// out of range, or empty.
fn mini_cli_arg(idx: u64) -> (ptr, u64, bool) {
    let argc = ENV_ARGS_JSON();
    if argc == 0 {
        return (PTR_NULL(), 0, false);
    };
    let root = JSON_PARSE(ENV_BUFFER_DATA(argc), ENV_BUFFER_LEN(argc));
    if root == PTR_NULL() {
        return (PTR_NULL(), 0, false);
    };
    let item_slot: ptr = PTR_NULL();
    let st = sa_json_array_get(root, idx, &item_slot);
    if st != 0 {
        return (PTR_NULL(), 0, false);
    };
    let item = item_slot;
    if item == PTR_NULL() {
        return (PTR_NULL(), 0, false);
    };
    let sptr_ref = sa_json_string_ptr(item);
    let pptr: ptr = sptr_ref;
    let plen = sa_json_string_len(item);
    if plen == 0 {
        return (PTR_NULL(), 0, false);
    };
    return (pptr, plen, true);
}

fn mini_cli_join_argv() -> (ptr, u64, bool) {
    return mini_cli_join_from(1);
}

// mini_cli_join_from(from): joins argv[from..] — used for the
// default prompt after optional --mcp prefix shifting.
fn mini_cli_join_from(from: u64) -> (ptr, u64, bool) {
    return mini_cli_join_range(from);
}

// mini_cli_arg(idx): argv[idx] as (ptr, len, ok). ok=false when missing,
// out of range, or empty.

// mini_cli_join_range(from): joins argv[from..] with single spaces into a
// heap string. ok=false when from is out of range.
fn mini_cli_join_range(from: u64) -> (ptr, u64, bool) {
    let argc = ENV_ARGS_JSON();
    if argc == 0 {
        return (PTR_NULL(), 0, false);
    };
    let root = JSON_PARSE(ENV_BUFFER_DATA(argc), ENV_BUFFER_LEN(argc));
    if root == PTR_NULL() {
        return (PTR_NULL(), 0, false);
    };
    let nslot: u64 = 0;
    if sa_json_value_count(root, &nslot) != 0 {
        return (PTR_NULL(), 0, false);
    };
    let n = nslot;
    if from >= n {
        return (PTR_NULL(), 0, false);
    };
    // pass 1: total length (sum of lens + 1 space per arg)
    var total: u64;
    total = 0;
    let i: u64 = from;
    while i < n {
        let islot: ptr = PTR_NULL();
        if sa_json_array_get(root, i, &islot) == 0 {
            let ilen = sa_json_string_len(islot);
            total = total + ilen + 1;
        };
        i = i + 1;
    }
    if total == 0 {
        return (PTR_NULL(), 0, false);
    };
    let buf = X_HEAP_BUF_PTR(total);
    // pass 2: copy
    var off: u64;
    off = 0;
    let j: u64 = from;
    while j < n {
        let jslot: ptr = PTR_NULL();
        if sa_json_array_get(root, j, &jslot) == 0 {
            let sptr_ref2 = sa_json_string_ptr(jslot);
            let sp: ptr = sptr_ref2;
            let sl = sa_json_string_len(jslot);
            let dst = X_PTR_ADD(buf, off);
            X_COPY_BYTES(dst, sp, sl);
            off = off + sl;
            let spc = X_PTR_ADD(buf, off);
            X_STORE_U8(spc, 32);
            off = off + 1;
        };
        j = j + 1;
    }
    // strip the trailing space
    return (buf, total - 1, true);
}

// mini_cli_run_image(path_idx): scodex-mini --image <path> <prompt...>
// Loads the image as base64 and sends it as multimodal input.
fn mini_cli_run_image(path_idx: u64) -> i32 {
    return mini_cli_run_image_mcp(path_idx, PTR_NULL(), 0);
}

fn mini_cli_run_image_mcp(path_idx: u64, mcp_ptr: ptr, mcp_len: u64) -> i32 {
    let (ppp, ppl, ppok) = mini_cli_arg(path_idx);
    if ppok != true {
        println("usage: scodex-mini --image <path> <prompt>");
        return 2;
    };
    let (prp, prl, prok) = mini_cli_join_range(path_idx + 1);
    if prok != true {
        println("usage: scodex-mini --image <path> <prompt>");
        return 2;
    };
    let cfg0 = mini_config_load();
    if cfg0.ok != true {
        println("scodex-mini: missing OPENAI_API_KEY");
        return 2;
    };
    let cfg = mini_config_apply_mcp(cfg0, mcp_ptr, mcp_len);
    let (b64p, b64l, bufh, mptr, mlen, iok) = mini_image_load(ppp, ppl);
    if iok != true {
        return 1;
    };
    if session_db_ensure() != true {
        return 1;
    };
    let sid = session_create(prp, prl);
    if sid == 0 {
        return 1;
    };
    // Persist as role 4 (user image message): {"text","img","mime"} JSON blob.
    // Buffered; flushed once after the run (even on error).
    let (blobp, bloblen) = mini_image_session_blob(prp, prl, b64p, b64l, mptr, mlen);
    let pend: Vec<PendingMsg> = Vec::new();
    pend = session_add_message(pend, 0, 4, blobp, bloblen);
    let items: Vec<MiniInputItem> = Vec::new();
    items.push(mini_input_user_image(prp, prl, b64p, b64l, mptr, mlen));
    // NOTE: bufh (image base64 buffer) stays alive for the whole run;
    // freed on process exit.
    let (code, pend2) = mini_model_run_conversation(cfg, sid, 1, items, pend);
    if session_flush_messages(sid, pend2) != true {
        return 1;
    };
    return code;
}

// mini_cli_run_file(path_idx): scodex-mini --file <path> <prompt...>
// Injects the text file's contents into the prompt as context.
fn mini_cli_run_file(path_idx: u64) -> i32 {
    return mini_cli_run_file_mcp(path_idx, PTR_NULL(), 0);
}

fn mini_cli_run_file_mcp(path_idx: u64, mcp_ptr: ptr, mcp_len: u64) -> i32 {
    let (ppp, ppl, ppok) = mini_cli_arg(path_idx);
    if ppok != true {
        println("usage: scodex-mini --file <path> <prompt>");
        return 2;
    };
    let (prp, prl, prok) = mini_cli_join_range(path_idx + 1);
    if prok != true {
        println("usage: scodex-mini --file <path> <prompt>");
        return 2;
    };
    let cfg0 = mini_config_load();
    if cfg0.ok != true {
        println("scodex-mini: missing OPENAI_API_KEY");
        return 2;
    };
    let cfg = mini_config_apply_mcp(cfg0, mcp_ptr, mcp_len);
    let (ftp, ftl, fbufh, fok) = mini_file_load_text(ppp, ppl);
    if fok != true {
        return 1;
    };
    let (cptr, clen) = mini_file_combine_prompt(ppp, ppl, ftp, ftl, prp, prl);
    if session_db_ensure() != true {
        return 1;
    };
    let sid = session_create(cptr, clen);
    if sid == 0 {
        return 1;
    };
    // Buffer the user message; flushed once after the run (even on error).
    let pend: Vec<PendingMsg> = Vec::new();
    pend = session_add_message(pend, 0, 0, cptr, clen);
    let items: Vec<MiniInputItem> = Vec::new();
    items.push(mini_input_user(cptr, clen));
    // NOTE: fbufh (file text buffer) stays alive for the whole run.
    let (code, pend2) = mini_model_run_conversation(cfg, sid, 1, items, pend);
    if session_flush_messages(sid, pend2) != true {
        return 1;
    };
    return code;
}

fn main() -> i32 {
    // Optional prefix: --mcp "<server command>" shifts arg parsing by 2.
    var arg_base: u64;
    arg_base = 1;
    var mcp_ptr: ptr;
    var mcp_len: u64;
    mcp_ptr = PTR_NULL();
    mcp_len = 0;
    let (a1p, a1l, a1ok) = mini_cli_arg(1);
    if a1ok == true {
        if mini_model_str_eq(a1p, a1l, STR_PTR("--mcp"), STR_LEN("--mcp")) == true {
            let (mcp, mcl, mok) = mini_cli_arg(2);
            if mok != true {
                println("usage: scodex-mini --mcp \"<server command>\" <prompt>");
                println("   or: scodex-mini --mcp \"<server command>\" --image <path> <prompt>");
                return 2;
            };
            mcp_ptr = mcp;
            mcp_len = mcl;
            arg_base = 3;
        };
    };
    // Linux Landlock sandbox. One-shot self-restriction inherited by every
    // child (shell_exec, curl, MCP servers). Opt-out is explicit only:
    //   scodex-mini --dangerously-skip-sandbox ...
    //   SCODEX_SANDBOX=0 scodex-mini ...
    // Any sandbox failure aborts instead of running unsandboxed.
    let (s1p, s1l, s1ok) = mini_cli_arg(arg_base);
    if s1ok == true {
        if mini_model_str_eq(s1p, s1l, STR_PTR("--dangerously-skip-sandbox"), STR_LEN("--dangerously-skip-sandbox")) == true {
            println("scodex-mini: WARNING: sandbox explicitly disabled via --dangerously-skip-sandbox.");
            arg_base = arg_base + 1;
        } else {
            let sbrc = sandbox_activate();
            if sbrc != 0 {
                return 2;
            };
        };
    } else {
        let sbrc = sandbox_activate();
        if sbrc != 0 {
            return 2;
        };
    };
    let (b1p, b1l, b1ok) = mini_cli_arg(arg_base);
    if b1ok == true {
        if mini_model_str_eq(b1p, b1l, STR_PTR("--list"), STR_LEN("--list")) == true {
            return session_list();
        };
        if mini_model_str_eq(b1p, b1l, STR_PTR("--resume"), STR_LEN("--resume")) == true {
            let (a2p, a2l, a2ok) = mini_cli_arg(arg_base + 1);
            let sid: u64 = 0;
            let sidok: bool = false;
            if a2ok == true {
                let (psid, pok) = mini_parse_u64(a2p, a2l);
                sid = psid;
                sidok = pok;
            };
            if a2ok != true {
                println("scodex-mini: invalid session id");
                println("usage: scodex-mini --resume <id> <prompt>");
                return 2;
            };
            if sidok != true {
                println("scodex-mini: invalid session id");
                println("usage: scodex-mini --resume <id> <prompt>");
                return 2;
            };
            let (prp, prl, prok) = mini_cli_join_range(arg_base + 2);
            if prok != true {
                println("usage: scodex-mini --resume <id> <prompt>");
                return 2;
            };
            let cfg0 = mini_config_load();
            if cfg0.ok != true {
                println("scodex-mini: missing OPENAI_API_KEY");
                return 2;
            };
            let cfg = mini_config_apply_mcp(cfg0, mcp_ptr, mcp_len);
            let (st, next_seq, items) = session_resume_load(sid);
            if st != 0 {
                return 1;
            };
            // Buffer the follow-up prompt; flushed once after the run.
            let pend: Vec<PendingMsg> = Vec::new();
            pend = session_add_message(pend, next_seq, 0, prp, prl);
            items.push(mini_input_user(prp, prl));
            let (code, pend2) = mini_model_run_conversation(cfg, sid, next_seq + 1, items, pend);
            if session_flush_messages(sid, pend2) != true {
                return 1;
            };
            return code;
        };
        if mini_model_str_eq(b1p, b1l, STR_PTR("--image"), STR_LEN("--image")) == true {
            return mini_cli_run_image_mcp(arg_base + 1, mcp_ptr, mcp_len);
        };
        if mini_model_str_eq(b1p, b1l, STR_PTR("-i"), STR_LEN("-i")) == true {
            return mini_cli_run_image_mcp(arg_base + 1, mcp_ptr, mcp_len);
        };
        if mini_model_str_eq(b1p, b1l, STR_PTR("--file"), STR_LEN("--file")) == true {
            return mini_cli_run_file_mcp(arg_base + 1, mcp_ptr, mcp_len);
        };
        if mini_model_str_eq(b1p, b1l, STR_PTR("-f"), STR_LEN("-f")) == true {
            return mini_cli_run_file_mcp(arg_base + 1, mcp_ptr, mcp_len);
        };
    };
    let cfg0 = mini_config_load();
    if cfg0.ok != true {
        println("scodex-mini: missing OPENAI_API_KEY");
        println("usage: scodex-mini <prompt>");
        return 2;
    };
    let cfg = mini_config_apply_mcp(cfg0, mcp_ptr, mcp_len);
    let (prompt_ptr, prompt_len, prompt_ok) = mini_cli_join_from(arg_base);
    if prompt_ok != true {
        println("usage: scodex-mini <prompt>");
        return 2;
    };
    if session_db_ensure() != true {
        return 1;
    };
    let sid = session_create(prompt_ptr, prompt_len);
    if sid == 0 {
        return 1;
    };
    // Buffer the user prompt; flushed once after the run (even on error).
    let pend: Vec<PendingMsg> = Vec::new();
    pend = session_add_message(pend, 0, 0, prompt_ptr, prompt_len);
    let items: Vec<MiniInputItem> = Vec::new();
    items.push(mini_input_user(prompt_ptr, prompt_len));
    let (code, pend2) = mini_model_run_conversation(cfg, sid, 1, items, pend);
    if session_flush_messages(sid, pend2) != true {
        return 1;
    };
    return code;
}
