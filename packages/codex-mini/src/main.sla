@import "sa_std/env.sa"
@import "sa_std/encoding/json.sa"
@import "jsonx.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/vec.sa"
@import "slicex.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/io/print.sai"
@import "config.sla"
@import "model.sla"


// mini_cli_arg(idx): argv[idx] as (ptr, len, ok). ok=false when missing,
// out of range, or empty.
fn mini_cli_arg(idx: u64) -> (ptr, u64, bool) {
    let argc = ENV_ARGS_JSON();
    if argc == 0 {
        return (PTR_NULL(), 0, false);
    };
    let root = JSON_PARSE(ENV_BUFFER_DATA(argc), ENV_BUFFER_LEN(argc));
    if root == PTR_NULL() {
        return (PTR_NULL(), 0, false);
    };
    let item_slot: ptr = PTR_NULL();
    let st = sa_json_array_get(root, idx, &item_slot);
    if st != 0 {
        return (PTR_NULL(), 0, false);
    };
    let item = item_slot;
    if item == PTR_NULL() {
        return (PTR_NULL(), 0, false);
    };
    let sptr_ref = sa_json_string_ptr(item);
    let pptr: ptr = sptr_ref;
    let plen = sa_json_string_len(item);
    if plen == 0 {
        return (PTR_NULL(), 0, false);
    };
    return (pptr, plen, true);
}

fn mini_cli_join_argv() -> (ptr, u64, bool) {
    let argc = ENV_ARGS_JSON();
    if argc == 0 {
        return (PTR_NULL(), 0, false);
    };
    let root = JSON_PARSE(ENV_BUFFER_DATA(argc), ENV_BUFFER_LEN(argc));
    if root == PTR_NULL() {
        return (PTR_NULL(), 0, false);
    };
    // Get argv[1] via extern (avoid macro chaining)
    let item_slot: ptr = PTR_NULL();
    let st = sa_json_array_get(root, 1, &item_slot);
    if st != 0 {
        return (PTR_NULL(), 0, false);
    };
    let item = item_slot;
    if item == PTR_NULL() {
        return (PTR_NULL(), 0, false);
    };
    let sptr_ref = sa_json_string_ptr(item);
    let pptr: ptr = sptr_ref;
    let plen = sa_json_string_len(item);
    if plen == 0 {
        return (PTR_NULL(), 0, false);
    };
    return (pptr, plen, true);
}

// mini_cli_arg(idx): argv[idx] as (ptr, len, ok). ok=false when missing,
// out of range, or empty.

// mini_cli_parse_u64: parses an all-digit ASCII string. Non-digit -> (0, false).
// NOTE: written without a u8->u64 `as` cast — that cast shape triggers
// error.CodegenError in the SAB lowering path (2026-09-18).
fn mini_cli_parse_u64(p: ptr, len: u64) -> (u64, bool) {
    if len == 0 {
        return (0, false);
    };
    var v: u64;
    v = 0;
    let i: u64 = 0;
    while i < len {
        let bp = X_PTR_ADD(p, i);
        let b = X_LOAD_U8(bp);
        if b < 48 {
            return (0, false);
        };
        if b > 57 {
            return (0, false);
        };
        v = v * 10;
        if b == 48 { v = v + 0; };
        if b == 49 { v = v + 1; };
        if b == 50 { v = v + 2; };
        if b == 51 { v = v + 3; };
        if b == 52 { v = v + 4; };
        if b == 53 { v = v + 5; };
        if b == 54 { v = v + 6; };
        if b == 55 { v = v + 7; };
        if b == 56 { v = v + 8; };
        if b == 57 { v = v + 9; };
        i = i + 1;
    }
    return (v, true);
}

// mini_cli_join_range(from): joins argv[from..] with single spaces into a
// heap string. ok=false when from is out of range.
fn mini_cli_join_range(from: u64) -> (ptr, u64, bool) {
    let argc = ENV_ARGS_JSON();
    if argc == 0 {
        return (PTR_NULL(), 0, false);
    };
    let root = JSON_PARSE(ENV_BUFFER_DATA(argc), ENV_BUFFER_LEN(argc));
    if root == PTR_NULL() {
        return (PTR_NULL(), 0, false);
    };
    let nslot: u64 = 0;
    if sa_json_value_count(root, &nslot) != 0 {
        return (PTR_NULL(), 0, false);
    };
    let n = nslot;
    if from >= n {
        return (PTR_NULL(), 0, false);
    };
    // pass 1: total length (sum of lens + 1 space per arg)
    var total: u64;
    total = 0;
    let i: u64 = from;
    while i < n {
        let islot: ptr = PTR_NULL();
        if sa_json_array_get(root, i, &islot) == 0 {
            let ilen = sa_json_string_len(islot);
            total = total + ilen + 1;
        };
        i = i + 1;
    }
    if total == 0 {
        return (PTR_NULL(), 0, false);
    };
    let buf = X_HEAP_BUF_PTR(total);
    // pass 2: copy
    var off: u64;
    off = 0;
    let j: u64 = from;
    while j < n {
        let jslot: ptr = PTR_NULL();
        if sa_json_array_get(root, j, &jslot) == 0 {
            let sptr_ref2 = sa_json_string_ptr(jslot);
            let sp: ptr = sptr_ref2;
            let sl = sa_json_string_len(jslot);
            let dst = X_PTR_ADD(buf, off);
            X_COPY_BYTES(dst, sp, sl);
            off = off + sl;
            let spc = X_PTR_ADD(buf, off);
            X_STORE_U8(spc, 32);
            off = off + 1;
        };
        j = j + 1;
    }
    // strip the trailing space
    return (buf, total - 1, true);
}

fn main() -> i32 {
    let (a1p, a1l, a1ok) = mini_cli_arg(1);
    if a1ok == true {
        if mini_model_str_eq(a1p, a1l, STR_PTR("--list"), STR_LEN("--list")) == true {
            return session_list();
        };
        if mini_model_str_eq(a1p, a1l, STR_PTR("--resume"), STR_LEN("--resume")) == true {
            let (a2p, a2l, a2ok) = mini_cli_arg(2);
            let sid: u64 = 0;
            let sidok: bool = false;
            if a2ok == true {
                let (psid, pok) = mini_cli_parse_u64(a2p, a2l);
                sid = psid;
                sidok = pok;
            };
            if a2ok != true {
                println("scodex-mini: invalid session id");
                println("usage: scodex-mini --resume <id> <prompt>");
                return 2;
            };
            if sidok != true {
                println("scodex-mini: invalid session id");
                println("usage: scodex-mini --resume <id> <prompt>");
                return 2;
            };
            let (prp, prl, prok) = mini_cli_join_range(3);
            if prok != true {
                println("usage: scodex-mini --resume <id> <prompt>");
                return 2;
            };
            let cfg = mini_config_load();
            if cfg.ok != true {
                println("scodex-mini: missing OPENAI_API_KEY");
                return 2;
            };
            let (st, next_seq, items) = session_resume_load(sid);
            if st != 0 {
                return 1;
            };
            if session_add_message(sid, next_seq, 0, prp, prl) != true {
                println("scodex-mini: session save failed");
                return 1;
            };
            items.push(mini_input_user(prp, prl));
            return mini_model_run_conversation(cfg, sid, next_seq + 1, items);
        };
    };
    let cfg = mini_config_load();
    if cfg.ok != true {
        println("scodex-mini: missing OPENAI_API_KEY");
        println("usage: scodex-mini <prompt>");
        return 2;
    };
    let (prompt_ptr, prompt_len, prompt_ok) = mini_cli_join_argv();
    if prompt_ok != true {
        println("usage: scodex-mini <prompt>");
        return 2;
    };
    if session_db_ensure() != true {
        return 1;
    };
    let sid = session_create(prompt_ptr, prompt_len);
    if sid == 0 {
        return 1;
    };
    if session_add_message(sid, 0, 0, prompt_ptr, prompt_len) != true {
        println("scodex-mini: session save failed");
        return 1;
    };
    let items: Vec<MiniInputItem> = Vec::new();
    items.push(mini_input_user(prompt_ptr, prompt_len));
    let code = mini_model_run_conversation(cfg, sid, 1, items);
    return code;
}
