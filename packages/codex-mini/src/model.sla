@import "sa_std/encoding/json.sai"
@import "sa_std/encoding/json.sa"
@import "jsonx.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/vec.sa"
@import "slicex.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/io/print.sai"
@import "config.sla"
@import "protocol.sla"
@import "http.sla"
@import "tools.sla"
@import "image.sla"
@import "skills.sla"
@import "mcp.sla"
@import "plugin_abi/db.sai"
@import "sa_std/time.sai"
@import "sessionx.sa"

enum MiniInputKind {
    UserText,
    AssistantText,
    FuncCall,
    FuncOutput,
}

struct MiniInputItem {
    kind: MiniInputKind,
    text_ptr: ptr,
    text_len: u64,
    call_id_ptr: ptr,
    call_id_len: u64,
    name_ptr: ptr,
    name_len: u64,
    args_ptr: ptr,
    args_len: u64,
    // Image payload for UserText items (base64, no data: prefix).
    // img_len == 0 means no image.
    img_ptr: ptr,
    img_len: u64,
    img_mime_ptr: ptr,
    img_mime_len: u64,
}

fn mini_input_user(text_ptr: ptr, text_len: u64) -> MiniInputItem {
    return MiniInputItem {
        kind: MiniInputKind::UserText,
        text_ptr: text_ptr,
        text_len: text_len,
        call_id_ptr: PTR_NULL(),
        call_id_len: 0,
        name_ptr: PTR_NULL(),
        name_len: 0,
        args_ptr: PTR_NULL(),
        args_len: 0,
        img_ptr: PTR_NULL(),
        img_len: 0,
        img_mime_ptr: PTR_NULL(),
        img_mime_len: 0,
    };
}

// User message with an attached image (base64 payload + MIME type).
fn mini_input_user_image(text_ptr: ptr, text_len: u64, img_ptr: ptr, img_len: u64, mime_ptr: ptr, mime_len: u64) -> MiniInputItem {
    return MiniInputItem {
        kind: MiniInputKind::UserText,
        text_ptr: text_ptr,
        text_len: text_len,
        call_id_ptr: PTR_NULL(),
        call_id_len: 0,
        name_ptr: PTR_NULL(),
        name_len: 0,
        args_ptr: PTR_NULL(),
        args_len: 0,
        img_ptr: img_ptr,
        img_len: img_len,
        img_mime_ptr: mime_ptr,
        img_mime_len: mime_len,
    };
}

fn mini_input_assistant(text_ptr: ptr, text_len: u64) -> MiniInputItem {
    return MiniInputItem {
        kind: MiniInputKind::AssistantText,
        text_ptr: text_ptr,
        text_len: text_len,
        call_id_ptr: PTR_NULL(),
        call_id_len: 0,
        name_ptr: PTR_NULL(),
        name_len: 0,
        args_ptr: PTR_NULL(),
        args_len: 0,
        img_ptr: PTR_NULL(),
        img_len: 0,
        img_mime_ptr: PTR_NULL(),
        img_mime_len: 0,
    };
}

fn mini_input_func_call(call_id_ptr: ptr, call_id_len: u64, name_ptr: ptr, name_len: u64, args_ptr: ptr, args_len: u64) -> MiniInputItem {
    return MiniInputItem {
        kind: MiniInputKind::FuncCall,
        text_ptr: PTR_NULL(),
        text_len: 0,
        call_id_ptr: call_id_ptr,
        call_id_len: call_id_len,
        name_ptr: name_ptr,
        name_len: name_len,
        args_ptr: args_ptr,
        args_len: args_len,
        img_ptr: PTR_NULL(),
        img_len: 0,
        img_mime_ptr: PTR_NULL(),
        img_mime_len: 0,
    };
}

fn mini_input_func_output(call_id_ptr: ptr, call_id_len: u64, out_ptr: ptr, out_len: u64) -> MiniInputItem {
    return MiniInputItem {
        kind: MiniInputKind::FuncOutput,
        text_ptr: out_ptr,
        text_len: out_len,
        call_id_ptr: call_id_ptr,
        call_id_len: call_id_len,
        name_ptr: PTR_NULL(),
        name_len: 0,
        args_ptr: PTR_NULL(),
        args_len: 0,
        img_ptr: PTR_NULL(),
        img_len: 0,
        img_mime_ptr: PTR_NULL(),
        img_mime_len: 0,
    };
}

fn mini_model_str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    return X_STR_EQ(a_ptr, a_len, b_ptr, b_len);
}

// Writes MCP tools (from mini_mcp_list_tools JSON) into the open "tools"
// array of the request.
// Responses API format: {"type":"function","name":...,"description":...,"parameters":<inputSchema>}
// Chat API format: {"type":"function","function":{"name":...,"description":...,"parameters":<inputSchema>}}
// chat_mode=1 for Chat API, 0 for Responses API.
// Returns true on success, false if the JSON is unusable (caller continues
// without MCP tools).
fn mini_model_write_mcp_tools(w: ptr, mcp_ptr: ptr, mcp_len: u64, chat_mode: u64) -> bool {
    let root = JSON_PARSE(mcp_ptr, mcp_len);
    if root == PTR_NULL() {
        return false;
    };
    let tslot: ptr = PTR_NULL();
    if sa_json_object_get(root, STR_PTR("tools"), STR_LEN("tools"), &tslot) != 0 {
        return false;
    };
    if tslot == PTR_NULL() {
        return false;
    };
    let nslot: u64 = 0;
    if sa_json_value_count(tslot, &nslot) != 0 {
        return false;
    };
    let n = nslot;
    let i: u64 = 0;
    while i < n {
        let islot: ptr = PTR_NULL();
        if sa_json_array_get(tslot, i, &islot) == 0 {
            if islot != PTR_NULL() {
                let nslot2: ptr = PTR_NULL();
                if sa_json_object_get(islot, STR_PTR("name"), STR_LEN("name"), &nslot2) == 0 {
                    if nslot2 != PTR_NULL() {
                        sa_json_writer_begin_object(w);
                        sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("function"), STR_LEN("function"));
                        // Chat API nests under "function" key.
                        if chat_mode == 1 {
                            sa_json_writer_object_field(w, STR_PTR("function"), STR_LEN("function"));
                            sa_json_writer_begin_object(w);
                        };
                        let nref = sa_json_string_ptr(nslot2);
                        let nptr: ptr = nref;
                        let nlen = sa_json_string_len(nslot2);
                        sa_json_writer_field_string(w, STR_PTR("name"), STR_LEN("name"), nptr, nlen);
                        let dslot: ptr = PTR_NULL();
                        if sa_json_object_get(islot, STR_PTR("description"), STR_LEN("description"), &dslot) == 0 {
                            if dslot != PTR_NULL() {
                                let dref = sa_json_string_ptr(dslot);
                                let dptr: ptr = dref;
                                let dlen = sa_json_string_len(dslot);
                                sa_json_writer_field_string(w, STR_PTR("description"), STR_LEN("description"), dptr, dlen);
                            };
                        };
                        let sslot: ptr = PTR_NULL();
                        if sa_json_object_get(islot, STR_PTR("inputSchema"), STR_LEN("inputSchema"), &sslot) == 0 {
                            if sslot != PTR_NULL() {
                                sa_json_writer_object_field(w, STR_PTR("parameters"), STR_LEN("parameters"));
                                sa_json_writer_write_node(w, sslot);
                            };
                        };
                        if chat_mode == 1 {
                            sa_json_writer_end_object(w);
                        };
                        sa_json_writer_end_object(w);
                    };
                };
            };
        };
        i = i + 1;
    }
    return true;
}

// Builds the /v1/responses request JSON. Returns (body_ptr, body_len, json_buf);
// the caller must keep json_buf alive while using the body, then free it with
// sa_json_buffer_free.
fn mini_model_build_request(
    cfg: MiniConfig,
    items: Vec<MiniInputItem>,
    skills_ptr: ptr,
    skills_len: u64,
    mcp_ptr: ptr,
    mcp_len: u64
) -> ptr {
    let w: ptr = PTR_NULL();
    sa_json_writer_new(0, 1, 0, 0, 0, &w);
    sa_json_writer_begin_object(w);
    sa_json_writer_field_string(w, STR_PTR("model"), STR_LEN("model"), cfg.model_ptr, cfg.model_len);
    sa_json_writer_field_bool(w, STR_PTR("stream"), STR_LEN("stream"), 1);
    if skills_len > 0 {
        sa_json_writer_field_string(w, STR_PTR("instructions"), STR_LEN("instructions"), skills_ptr, skills_len);
    };
    sa_json_writer_object_field(w, STR_PTR("input"), STR_LEN("input"));
    sa_json_writer_begin_array(w);
    let n: u64 = items.len();
    let i: u64 = 0;
    while i < n {
        let item = items[i];
        sa_json_writer_begin_object(w);
        match item.kind {
            MiniInputKind::UserText => {
                sa_json_writer_field_string(w, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
                sa_json_writer_object_field(w, STR_PTR("content"), STR_LEN("content"));
                sa_json_writer_begin_array(w);
                sa_json_writer_begin_object(w);
                sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("input_text"), STR_LEN("input_text"));
                sa_json_writer_field_string(w, STR_PTR("text"), STR_LEN("text"), item.text_ptr, item.text_len);
                sa_json_writer_end_object(w);
                if item.img_len > 0 {
                    let (durl_ptr, durl_len) = mini_image_data_url(item.img_mime_ptr, item.img_mime_len, item.img_ptr, item.img_len);
                    sa_json_writer_begin_object(w);
                    sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("input_image"), STR_LEN("input_image"));
                    sa_json_writer_field_string(w, STR_PTR("image_url"), STR_LEN("image_url"), durl_ptr, durl_len);
                    sa_json_writer_end_object(w);
                };
                sa_json_writer_end_array(w);
            },
            MiniInputKind::AssistantText => {
                sa_json_writer_field_string(w, STR_PTR("role"), STR_LEN("role"), STR_PTR("assistant"), STR_LEN("assistant"));
                sa_json_writer_field_string(w, STR_PTR("content"), STR_LEN("content"), item.text_ptr, item.text_len);
            },
            MiniInputKind::FuncCall => {
                sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("function_call"), STR_LEN("function_call"));
                sa_json_writer_field_string(w, STR_PTR("call_id"), STR_LEN("call_id"), item.call_id_ptr, item.call_id_len);
                sa_json_writer_field_string(w, STR_PTR("name"), STR_LEN("name"), item.name_ptr, item.name_len);
                sa_json_writer_field_string(w, STR_PTR("arguments"), STR_LEN("arguments"), item.args_ptr, item.args_len);
            },
            MiniInputKind::FuncOutput => {
                sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("function_call_output"), STR_LEN("function_call_output"));
                sa_json_writer_field_string(w, STR_PTR("call_id"), STR_LEN("call_id"), item.call_id_ptr, item.call_id_len);
                sa_json_writer_field_string(w, STR_PTR("output"), STR_LEN("output"), item.text_ptr, item.text_len);
            },
        };
        sa_json_writer_end_object(w);
        i = i + 1;
    }
    sa_json_writer_end_array(w);
    sa_json_writer_object_field(w, STR_PTR("tools"), STR_LEN("tools"));
    sa_json_writer_begin_array(w);
    sa_json_writer_begin_object(w);
    sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("function"), STR_LEN("function"));
    sa_json_writer_field_string(w, STR_PTR("name"), STR_LEN("name"), STR_PTR("shell_exec"), STR_LEN("shell_exec"));
    sa_json_writer_field_string(w, STR_PTR("description"), STR_LEN("description"), STR_PTR("Run a shell command via sh -c and return its stdout."), STR_LEN("Run a shell command via sh -c and return its stdout."));
    sa_json_writer_object_field(w, STR_PTR("parameters"), STR_LEN("parameters"));
    sa_json_writer_begin_object(w);
    sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("object"), STR_LEN("object"));
    sa_json_writer_object_field(w, STR_PTR("properties"), STR_LEN("properties"));
    sa_json_writer_begin_object(w);
    sa_json_writer_object_field(w, STR_PTR("command"), STR_LEN("command"));
    sa_json_writer_begin_object(w);
    sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("string"), STR_LEN("string"));
    sa_json_writer_field_string(w, STR_PTR("description"), STR_LEN("description"), STR_PTR("Shell command to run."), STR_LEN("Shell command to run."));
    sa_json_writer_end_object(w);
    sa_json_writer_end_object(w);
    sa_json_writer_object_field(w, STR_PTR("required"), STR_LEN("required"));
    sa_json_writer_begin_array(w);
    sa_json_writer_write_string(w, STR_PTR("command"), STR_LEN("command"));
    sa_json_writer_end_array(w);
    sa_json_writer_end_object(w);
    sa_json_writer_end_object(w);
    if mcp_len > 0 {
        mini_model_write_mcp_tools(w, mcp_ptr, mcp_len, 0);
    };
    sa_json_writer_end_array(w);
    sa_json_writer_end_object(w);
    let buf = sa_json_writer_finish_buffer(w);
    sa_json_writer_free(w);
    return buf;
}

// Chat Completions API request builder.
// Format: {"model": "...", "messages": [...], "tools": [...]}
fn mini_model_build_request_chat(
    cfg: MiniConfig,
    items: Vec<MiniInputItem>,
    skills_ptr: ptr,
    skills_len: u64,
    mcp_ptr: ptr,
    mcp_len: u64
) -> ptr {
    let w: ptr = PTR_NULL();
    sa_json_writer_new(0, 1, 0, 0, 0, &w);
    sa_json_writer_begin_object(w);
    sa_json_writer_field_string(w, STR_PTR("model"), STR_LEN("model"), cfg.model_ptr, cfg.model_len);
    sa_json_writer_field_bool(w, STR_PTR("stream"), STR_LEN("stream"), 1);
    sa_json_writer_object_field(w, STR_PTR("messages"), STR_LEN("messages"));
    sa_json_writer_begin_array(w);
    if skills_len > 0 {
        sa_json_writer_begin_object(w);
        sa_json_writer_field_string(w, STR_PTR("role"), STR_LEN("role"), STR_PTR("system"), STR_LEN("system"));
        sa_json_writer_field_string(w, STR_PTR("content"), STR_LEN("content"), skills_ptr, skills_len);
        sa_json_writer_end_object(w);
    };
    let n: u64 = items.len();
    let i: u64 = 0;
    while i < n {
        let item = items[i];
        sa_json_writer_begin_object(w);
        match item.kind {
            MiniInputKind::UserText => {
                sa_json_writer_field_string(w, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
                if item.img_len > 0 {
                    sa_json_writer_object_field(w, STR_PTR("content"), STR_LEN("content"));
                    sa_json_writer_begin_array(w);
                    sa_json_writer_begin_object(w);
                    sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
                    sa_json_writer_field_string(w, STR_PTR("text"), STR_LEN("text"), item.text_ptr, item.text_len);
                    sa_json_writer_end_object(w);
                    let (durl_ptr2, durl_len2) = mini_image_data_url(item.img_mime_ptr, item.img_mime_len, item.img_ptr, item.img_len);
                    sa_json_writer_begin_object(w);
                    sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("image_url"), STR_LEN("image_url"));
                    sa_json_writer_object_field(w, STR_PTR("image_url"), STR_LEN("image_url"));
                    sa_json_writer_begin_object(w);
                    sa_json_writer_field_string(w, STR_PTR("url"), STR_LEN("url"), durl_ptr2, durl_len2);
                    sa_json_writer_end_object(w);
                    sa_json_writer_end_object(w);
                    sa_json_writer_end_array(w);
                } else {
                    sa_json_writer_field_string(w, STR_PTR("content"), STR_LEN("content"), item.text_ptr, item.text_len);
                };
            },
            MiniInputKind::AssistantText => {
                sa_json_writer_field_string(w, STR_PTR("role"), STR_LEN("role"), STR_PTR("assistant"), STR_LEN("assistant"));
                sa_json_writer_field_string(w, STR_PTR("content"), STR_LEN("content"), item.text_ptr, item.text_len);
            },
            MiniInputKind::FuncCall => {
                sa_json_writer_field_string(w, STR_PTR("role"), STR_LEN("role"), STR_PTR("assistant"), STR_LEN("assistant"));
                sa_json_writer_object_field(w, STR_PTR("content"), STR_LEN("content"));
                sa_json_writer_write_null(w);
                sa_json_writer_object_field(w, STR_PTR("tool_calls"), STR_LEN("tool_calls"));
                sa_json_writer_begin_array(w);
                sa_json_writer_begin_object(w);
                sa_json_writer_field_string(w, STR_PTR("id"), STR_LEN("id"), item.call_id_ptr, item.call_id_len);
                sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("function"), STR_LEN("function"));
                sa_json_writer_object_field(w, STR_PTR("function"), STR_LEN("function"));
                sa_json_writer_begin_object(w);
                sa_json_writer_field_string(w, STR_PTR("name"), STR_LEN("name"), item.name_ptr, item.name_len);
                sa_json_writer_field_string(w, STR_PTR("arguments"), STR_LEN("arguments"), item.args_ptr, item.args_len);
                sa_json_writer_end_object(w);
                sa_json_writer_end_object(w);
                sa_json_writer_end_array(w);
            },
            MiniInputKind::FuncOutput => {
                sa_json_writer_field_string(w, STR_PTR("role"), STR_LEN("role"), STR_PTR("tool"), STR_LEN("tool"));
                sa_json_writer_field_string(w, STR_PTR("tool_call_id"), STR_LEN("tool_call_id"), item.call_id_ptr, item.call_id_len);
                sa_json_writer_field_string(w, STR_PTR("content"), STR_LEN("content"), item.text_ptr, item.text_len);
            },
        };
        sa_json_writer_end_object(w);
        i = i + 1;
    }
    sa_json_writer_end_array(w);
    sa_json_writer_object_field(w, STR_PTR("tools"), STR_LEN("tools"));
    sa_json_writer_begin_array(w);
    sa_json_writer_begin_object(w);
    sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("function"), STR_LEN("function"));
    sa_json_writer_object_field(w, STR_PTR("function"), STR_LEN("function"));
    sa_json_writer_begin_object(w);
    sa_json_writer_field_string(w, STR_PTR("name"), STR_LEN("name"), STR_PTR("shell_exec"), STR_LEN("shell_exec"));
    sa_json_writer_field_string(w, STR_PTR("description"), STR_LEN("description"), STR_PTR("Run a shell command via sh -c and return its stdout."), STR_LEN("Run a shell command via sh -c and return its stdout."));
    sa_json_writer_object_field(w, STR_PTR("parameters"), STR_LEN("parameters"));
    sa_json_writer_begin_object(w);
    sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("object"), STR_LEN("object"));
    sa_json_writer_object_field(w, STR_PTR("properties"), STR_LEN("properties"));
    sa_json_writer_begin_object(w);
    sa_json_writer_object_field(w, STR_PTR("command"), STR_LEN("command"));
    sa_json_writer_begin_object(w);
    sa_json_writer_field_string(w, STR_PTR("type"), STR_LEN("type"), STR_PTR("string"), STR_LEN("string"));
    sa_json_writer_field_string(w, STR_PTR("description"), STR_LEN("description"), STR_PTR("Shell command to run."), STR_LEN("Shell command to run."));
    sa_json_writer_end_object(w);
    sa_json_writer_end_object(w);
    sa_json_writer_object_field(w, STR_PTR("required"), STR_LEN("required"));
    sa_json_writer_begin_array(w);
    sa_json_writer_write_string(w, STR_PTR("command"), STR_LEN("command"));
    sa_json_writer_end_array(w);
    sa_json_writer_end_object(w);
    sa_json_writer_end_object(w);
    sa_json_writer_end_object(w);
    if mcp_len > 0 {
        mini_model_write_mcp_tools(w, mcp_ptr, mcp_len, 1);
    };
    sa_json_writer_end_array(w);
    sa_json_writer_end_object(w);
    let buf = sa_json_writer_finish_buffer(w);
    sa_json_writer_free(w);
    return buf;
}

// Dispatch to mode-specific request builder.
fn mini_model_build_request_dispatch(
    cfg: MiniConfig,
    items: Vec<MiniInputItem>,
    skills_ptr: ptr,
    skills_len: u64,
    mcp_ptr: ptr,
    mcp_len: u64
) -> ptr {
    if cfg.api_mode == 1 {
        return mini_model_build_request_chat(cfg, items, skills_ptr, skills_len, mcp_ptr, mcp_len);
    };
    return mini_model_build_request(cfg, items, skills_ptr, skills_len, mcp_ptr, mcp_len);
}

fn mini_model_build_url(cfg: MiniConfig) -> (ptr, u64) {
    // Mode-aware URL. Appends the endpoint path to cfg.base_url.
    var suffix_ptr: ptr;
    var suffix_len: u64;
    if cfg.api_mode == 1 {
        suffix_ptr = STR_PTR("/chat/completions");
        suffix_len = STR_LEN("/chat/completions");
    } else {
        suffix_ptr = STR_PTR("/responses");
        suffix_len = STR_LEN("/responses");
    };
    let total = cfg.base_url_len + suffix_len;
    let out = X_HEAP_BUF_PTR(total);
    X_COPY_BYTES(out, cfg.base_url_ptr, cfg.base_url_len);
    X_COPY_BYTES(X_PTR_ADD(out, cfg.base_url_len), suffix_ptr, suffix_len);
    return (out, total);
}

// Parses a non-streaming /v1/responses JSON body into a turn outcome.
fn mini_model_parse_response(body_ptr: ptr, body_len: u64) -> MiniTurnOutcome {
    let outcome = mini_turn_outcome_failed(5001);
    let root = JSON_PARSE(body_ptr, body_len);
    if root == PTR_NULL() {
        return outcome;
    };
    let okey = STR_PTR("output");
    let okey_len = STR_LEN("output");
    if X_OBJ_HAS(root, okey, okey_len) != true {
        outcome.error_code = 5002;
        return outcome;
    };
    let output_slot: ptr = PTR_NULL();
    if sa_json_object_get(root, okey, okey_len, &output_slot) != 0 {
        outcome.error_code = 5002;
        return outcome;
    };
    let output = output_slot;
    let cnt_slot: u64 = 0;
    if sa_json_value_count(output, &cnt_slot) != 0 {
        outcome.error_code = 5003;
        return outcome;
    };
    let n = cnt_slot;
    let i: u64 = 0;
    while i < n {
        let item_slot: ptr = PTR_NULL();
        if sa_json_array_get(output, i, &item_slot) == 0 {
            let item = item_slot;
            let tkey = STR_PTR("type");
            let tkey_len = STR_LEN("type");
            if X_OBJ_HAS(item, tkey, tkey_len) == true {
                let tptr = X_OBJ_STR_PTR(item, tkey, tkey_len);
                let tlen = X_OBJ_STR_LEN(item, tkey, tkey_len);
                if mini_model_str_eq(tptr, tlen, STR_PTR("message"), STR_LEN("message")) {
                    let ckey = STR_PTR("content");
                    let ckey_len = STR_LEN("content");
                    if X_OBJ_HAS(item, ckey, ckey_len) == true {
                        let cslot: ptr = PTR_NULL();
                        if sa_json_object_get(item, ckey, ckey_len, &cslot) == 0 {
                            let c0slot: ptr = PTR_NULL();
                            if sa_json_array_get(cslot, 0, &c0slot) == 0 {
                                let txkey = STR_PTR("text");
                                let txkey_len = STR_LEN("text");
                                if X_OBJ_HAS(c0slot, txkey, txkey_len) == true {
                                    outcome.kind = MiniEventKind::TextDelta;
                                    outcome.text_ptr = X_OBJ_STR_PTR(c0slot, txkey, txkey_len);
                                    outcome.text_len = X_OBJ_STR_LEN(c0slot, txkey, txkey_len);
                                };
                            };
                        };
                    };
                };
                if mini_model_str_eq(tptr, tlen, STR_PTR("function_call"), STR_LEN("function_call")) {
                    let idkey = STR_PTR("call_id");
                    let idkey_len = STR_LEN("call_id");
                    let nmkey = STR_PTR("name");
                    let nmkey_len = STR_LEN("name");
                    let agkey = STR_PTR("arguments");
                    let agkey_len = STR_LEN("arguments");
                    if X_OBJ_HAS(item, idkey, idkey_len) == true {
                        if X_OBJ_HAS(item, nmkey, nmkey_len) == true {
                            if X_OBJ_HAS(item, agkey, agkey_len) == true {
                                let call = mini_tool_call_empty();
                                call.call_id_ptr = X_OBJ_STR_PTR(item, idkey, idkey_len);
                                call.call_id_len = X_OBJ_STR_LEN(item, idkey, idkey_len);
                                call.name_ptr = X_OBJ_STR_PTR(item, nmkey, nmkey_len);
                                call.name_len = X_OBJ_STR_LEN(item, nmkey, nmkey_len);
                                call.args_ptr = X_OBJ_STR_PTR(item, agkey, agkey_len);
                                call.args_len = X_OBJ_STR_LEN(item, agkey, agkey_len);
                                outcome.calls.push(call);
                                outcome.kind = MiniEventKind::ToolCall;
                            };
                        };
                    };
                };
            };
        };
        i = i + 1;
    }
    match outcome.kind {
        MiniEventKind::Failed => {
            outcome.kind = MiniEventKind::TurnDone;
            outcome.error_code = 0;
        },
        MiniEventKind::TextDelta => {},
        MiniEventKind::ToolCall => {},
        MiniEventKind::TurnDone => {},
    };
    return outcome;
}



// Parses a non-streaming /v1/chat/completions JSON body into a turn outcome.
// Format: {"choices": [{"message": {"content": "...", "tool_calls": [...]}}]}
fn mini_model_parse_response_chat(body_ptr: ptr, body_len: u64) -> MiniTurnOutcome {
    let outcome = mini_turn_outcome_failed(6001);
    let root = JSON_PARSE(body_ptr, body_len);
    if root == PTR_NULL() {
        return outcome;
    };
    let ckey = STR_PTR("choices");
    let ckey_len = STR_LEN("choices");
    if X_OBJ_HAS(root, ckey, ckey_len) != true {
        outcome.error_code = 6002;
        return outcome;
    };
    let choices_slot: ptr = PTR_NULL();
    if sa_json_object_get(root, ckey, ckey_len, &choices_slot) != 0 {
        outcome.error_code = 6002;
        return outcome;
    };
    let c0slot: ptr = PTR_NULL();
    if sa_json_array_get(choices_slot, 0, &c0slot) != 0 {
        outcome.error_code = 6003;
        return outcome;
    };
    let mkey = STR_PTR("message");
    let mkey_len = STR_LEN("message");
    if X_OBJ_HAS(c0slot, mkey, mkey_len) != true {
        outcome.error_code = 6004;
        return outcome;
    };
    let msg_slot: ptr = PTR_NULL();
    if sa_json_object_get(c0slot, mkey, mkey_len, &msg_slot) != 0 {
        outcome.error_code = 6004;
        return outcome;
    };
    let msg = msg_slot;
    let tckey = STR_PTR("tool_calls");
    let tckey_len = STR_LEN("tool_calls");
    if X_OBJ_HAS(msg, tckey, tckey_len) == true {
        let tc_slot: ptr = PTR_NULL();
        if sa_json_object_get(msg, tckey, tckey_len, &tc_slot) == 0 {
            let tc0slot: ptr = PTR_NULL();
            if sa_json_array_get(tc_slot, 0, &tc0slot) == 0 {
                let idkey = STR_PTR("id");
                let idkey_len = STR_LEN("id");
                let fkey = STR_PTR("function");
                let fkey_len = STR_LEN("function");
                if X_OBJ_HAS(tc0slot, idkey, idkey_len) == true {
                    if X_OBJ_HAS(tc0slot, fkey, fkey_len) == true {
                        let fslot: ptr = PTR_NULL();
                        if sa_json_object_get(tc0slot, fkey, fkey_len, &fslot) == 0 {
                            let nkey = STR_PTR("name");
                            let nkey_len = STR_LEN("name");
                            let akey = STR_PTR("arguments");
                            let akey_len = STR_LEN("arguments");
                            if X_OBJ_HAS(fslot, nkey, nkey_len) == true {
                                if X_OBJ_HAS(fslot, akey, akey_len) == true {
                                    let call = mini_tool_call_empty();
                                    call.call_id_ptr = X_OBJ_STR_PTR(tc0slot, idkey, idkey_len);
                                    call.call_id_len = X_OBJ_STR_LEN(tc0slot, idkey, idkey_len);
                                    call.name_ptr = X_OBJ_STR_PTR(fslot, nkey, nkey_len);
                                    call.name_len = X_OBJ_STR_LEN(fslot, nkey, nkey_len);
                                    call.args_ptr = X_OBJ_STR_PTR(fslot, akey, akey_len);
                                    call.args_len = X_OBJ_STR_LEN(fslot, akey, akey_len);
                                    outcome.calls.push(call);
                                    outcome.kind = MiniEventKind::ToolCall;
                                    return outcome;
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    let cokey = STR_PTR("content");
    let cokey_len = STR_LEN("content");
    if X_OBJ_HAS(msg, cokey, cokey_len) == true {
        let co_ptr = X_OBJ_STR_PTR(msg, cokey, cokey_len);
        let co_len = X_OBJ_STR_LEN(msg, cokey, cokey_len);
        if co_ptr != PTR_NULL() {
            outcome.kind = MiniEventKind::TextDelta;
            outcome.text_ptr = co_ptr;
            outcome.text_len = co_len;
            return outcome;
        };
    };
    outcome.kind = MiniEventKind::TurnDone;
    outcome.error_code = 0;
    return outcome;
}

// Dispatch to mode-specific response parser.
fn mini_model_parse_response_dispatch(mode: u64, body_ptr: ptr, body_len: u64) -> MiniTurnOutcome {
    if mode == 1 {
        return mini_model_parse_response_chat(body_ptr, body_len);
    };
    return mini_model_parse_response(body_ptr, body_len);
}

// Extracts the "command" argument from a function_call arguments JSON object.
fn mini_model_tool_command(args_ptr: ptr, args_len: u64) -> (ptr, u64, bool) {
    let root = JSON_PARSE(args_ptr, args_len);
    if root == PTR_NULL() {
        return (PTR_NULL(), 0, false);
    };
    let ckey = STR_PTR("command");
    let ckey_len = STR_LEN("command");
    if X_OBJ_HAS(root, ckey, ckey_len) != true {
        return (PTR_NULL(), 0, false);
    };
    let cptr = X_OBJ_STR_PTR(root, ckey, ckey_len);
    let clen = X_OBJ_STR_LEN(root, ckey, ckey_len);
    return (cptr, clen, true);
}

// Single-turn agent loop: prompt -> model -> (tool calls -> exec -> model)* -> done.
// Mirrors the Rust codex-min single-turn behavior.
fn mini_model_run_conversation(
    cfg: MiniConfig,
    session_id: u64,
    start_seq: u64,
    items: Vec<MiniInputItem>,
    pend: Vec<PendingMsg>
) -> (i32, Vec<PendingMsg>) {
    let p: Vec<PendingMsg> = pend;
    var seq: u64;
    seq = start_seq;
    let (url_ptr, url_len) = mini_model_build_url(cfg);
    // Load skills once per run (not an error when none exist).
    let (skills_ptr, skills_len, skills_ok) = mini_skills_load();
    var eff_skills_ptr: ptr;
    var eff_skills_len: u64;
    eff_skills_ptr = PTR_NULL();
    eff_skills_len = 0;
    if skills_ok == true {
        eff_skills_ptr = skills_ptr;
        eff_skills_len = skills_len;
    };
    // List MCP tools once per run when --mcp / SCODEX_MCP is set.
    var mcp_tools_ptr: ptr;
    var mcp_tools_len: u64;
    mcp_tools_ptr = PTR_NULL();
    mcp_tools_len = 0;
    if cfg.mcp_cmd_len > 0 {
        let (mp, ml, mok) = mini_mcp_list_tools(cfg.mcp_cmd_ptr, cfg.mcp_cmd_len);
        if mok == true {
            mcp_tools_ptr = mp;
            mcp_tools_len = ml;
        } else {
            println("scodex-mini: warning: mcp tool list failed, continuing without mcp tools");
        };
    };
    let turn: u64 = 0;
    while turn < cfg.max_turns {
        let json_buf = mini_model_build_request_dispatch(cfg, items, eff_skills_ptr, eff_skills_len, mcp_tools_ptr, mcp_tools_len);
        if json_buf == PTR_NULL() {
            println("scodex-mini: failed to build request");
            return (1, p);
        };
        let body_ref = sa_json_buffer_data(json_buf);
        let body_ptr: ptr = body_ref;
        let body_len = sa_json_buffer_len(json_buf);
        // SSE streaming turn (native plugin does POST + event parsing + live print).
        let sse_text_ptr: ptr = PTR_NULL();
        var sse_text_len: u64;
        sse_text_len = 0;
        let sse_calls_ptr: ptr = PTR_NULL();
        var sse_calls_len: u64;
        sse_calls_len = 0;
        let sse_rc = sa_http_client_sse_turn(url_ptr, url_len, body_ptr, body_len, cfg.api_key_ptr, cfg.api_key_len, cfg.api_mode, &sse_text_ptr, &sse_text_len, &sse_calls_ptr, &sse_calls_len);
        if sse_rc == 2 {
            println("scodex-mini: sse request failed");
            return (1, p);
        };
        // Build outcome from native result. Text was already streamed live.
        let outcome = mini_turn_outcome_failed(0);
        outcome.kind = MiniEventKind::TextDelta;
        outcome.text_ptr = sse_text_ptr;
        outcome.text_len = sse_text_len;
        outcome.error_code = 0;
        if sse_rc == 1 {
            // Tool calls: parse the JSON array from native.
            outcome.kind = MiniEventKind::ToolCall;
            outcome.calls = mini_sse_parse_calls_json(sse_calls_ptr, sse_calls_len);
        };
        // NOTE: sse_text_ptr and sse_calls_ptr must stay alive through the match
        // below (outcome.text_ptr and outcome.calls reference them). Freed at
        // end of loop iteration.
        match outcome.kind {
            MiniEventKind::Failed => {
                println("scodex-mini: response parse failed code={}", outcome.error_code);
                sa_http_client_sse_turn_free(sse_text_ptr, sse_text_len);
                sa_http_client_sse_turn_free(sse_calls_ptr, sse_calls_len);
                return (1, p);
            },
            MiniEventKind::TextDelta => {
                // Text was already streamed live by native sse_turn; buffer it.
                // Flushed (one tx) by the caller after the run.
                p = session_add_message(p, seq, 1, outcome.text_ptr, outcome.text_len);
                sa_http_client_sse_turn_free(sse_text_ptr, sse_text_len);
                sa_http_client_sse_turn_free(sse_calls_ptr, sse_calls_len);
                seq = seq + 1;
                return (0, p);
            },
            MiniEventKind::ToolCall => {
                let ncalls = outcome.calls.len();
                let ci: u64 = 0;
                while ci < ncalls {
                    let call = outcome.calls[ci];
                    // 1. Save tool call as JSON (role 2). Buffer must stay alive through blob_put.
                    let w: ptr = PTR_NULL();
                    sa_json_writer_new(0, 1, 0, 0, 0, &w);
                    sa_json_writer_begin_object(w);
                    sa_json_writer_field_string(w, STR_PTR("call_id"), STR_LEN("call_id"), call.call_id_ptr, call.call_id_len);
                    sa_json_writer_field_string(w, STR_PTR("name"), STR_LEN("name"), call.name_ptr, call.name_len);
                    sa_json_writer_field_string(w, STR_PTR("args"), STR_LEN("args"), call.args_ptr, call.args_len);
                    sa_json_writer_end_object(w);
                    let buf = sa_json_writer_finish_buffer(w);
                    sa_json_writer_free(w);
                    let bptr_ref = sa_json_buffer_data(buf);
                    let bptr: ptr = bptr_ref;
                    let blen = sa_json_buffer_len(buf);
                    // Buffer the tool call (role 2); flushed by the caller.
                    p = session_add_message(p, seq, 2, bptr, blen);
                    sa_json_buffer_free(buf);
                    seq = seq + 1;
                    // 2. Execute the tool.
                    let out_ptr: ptr = PTR_NULL();
                    let out_len: u64 = 0;
                    if mini_model_str_eq(call.name_ptr, call.name_len, STR_PTR("shell_exec"), STR_LEN("shell_exec")) {
                        let (cmd_ptr, cmd_len, cmd_ok) = mini_model_tool_command(call.args_ptr, call.args_len);
                        if cmd_ok == true {
                            let exec = mini_shell_exec(cmd_ptr, cmd_len);
                            if exec.ok == true {
                                out_ptr = exec.out_ptr;
                                out_len = exec.out_len;
                            } else {
                                out_ptr = STR_PTR("(exec failed)");
                                out_len = STR_LEN("(exec failed)");
                            };
                        } else {
                            out_ptr = STR_PTR("(bad arguments)");
                            out_len = STR_LEN("(bad arguments)");
                        };
                    } else if cfg.mcp_cmd_len > 0 {
                        // Route any non-shell tool through the MCP bridge.
                        let (mcp_out_ptr, mcp_out_len, mcp_ok) = mini_mcp_call_tool(
                            cfg.mcp_cmd_ptr, cfg.mcp_cmd_len,
                            call.name_ptr, call.name_len,
                            call.args_ptr, call.args_len
                        );
                        if mcp_ok == true {
                            out_ptr = mcp_out_ptr;
                            out_len = mcp_out_len;
                        } else {
                            out_ptr = STR_PTR("(mcp call failed)");
                            out_len = STR_LEN("(mcp call failed)");
                        };
                    } else {
                        out_ptr = STR_PTR("(unknown tool)");
                        out_len = STR_LEN("(unknown tool)");
                    };
                    // 3. Save tool output as JSON (role 3).
                    let w2: ptr = PTR_NULL();
                    sa_json_writer_new(0, 1, 0, 0, 0, &w2);
                    sa_json_writer_begin_object(w2);
                    sa_json_writer_field_string(w2, STR_PTR("call_id"), STR_LEN("call_id"), call.call_id_ptr, call.call_id_len);
                    sa_json_writer_field_string(w2, STR_PTR("output"), STR_LEN("output"), out_ptr, out_len);
                    sa_json_writer_end_object(w2);
                    let buf2 = sa_json_writer_finish_buffer(w2);
                    sa_json_writer_free(w2);
                    let bptr2_ref = sa_json_buffer_data(buf2);
                    let bptr2: ptr = bptr2_ref;
                    let blen2 = sa_json_buffer_len(buf2);
                    // Buffer the tool output (role 3); flushed by the caller.
                    p = session_add_message(p, seq, 3, bptr2, blen2);
                    sa_json_buffer_free(buf2);
                    seq = seq + 1;
                    // 4. Push the original function_call (required by the API: every
                    // function_call_output must be preceded by its function_call
                    // with a matching call_id), then the output, for the next request.
                    items.push(mini_input_func_call(call.call_id_ptr, call.call_id_len, call.name_ptr, call.name_len, call.args_ptr, call.args_len));
                    items.push(mini_input_func_output(call.call_id_ptr, call.call_id_len, out_ptr, out_len));
                    ci = ci + 1;
                }
            },
            MiniEventKind::TurnDone => {
                sa_http_client_sse_turn_free(sse_text_ptr, sse_text_len);
                sa_http_client_sse_turn_free(sse_calls_ptr, sse_calls_len);
                return (0, p);
            },
        };
        // Free SSE buffers now that outcome is fully consumed.
        sa_http_client_sse_turn_free(sse_text_ptr, sse_text_len);
        sa_http_client_sse_turn_free(sse_calls_ptr, sse_calls_len);
        turn = turn + 1;
    }
    // Max turns exhausted: the caller flushes the buffered messages.
    return (0, p);
}

@test "model input item constructors"() {
    let u = mini_input_user(STR_PTR("hi"), STR_LEN("hi"));
    if u.text_len != 2 { panic(501); };
    let f = mini_input_func_output(STR_PTR("c1"), STR_LEN("c1"), STR_PTR("ok"), STR_LEN("ok"));
    if f.call_id_len != 2 { panic(502); };
}
// ---- Session persistence (DB-backed) ----
// DB root: $HOME/.scodex-mini/db

struct DbTableInfo {
    row_count: u64,
    segment_count: u64,
    epoch: u64,
    locked: u64,
}

struct DbSnapshotInfo {
    row_count: u64,
    column_count: u64,
    row_bytes: u64,
    epoch: u64,
}

struct SessionRow {
    id: u64,
    created_ms: u64,
    updated_ms: u64,
    msg_count: u64,
    title_blob: u64,
}

struct MessageRow {
    session_id: u64,
    seq: u64,
    role: u64,
    body_blob: u64,
}

// A message buffered for batched persistence. body_ptr points to a
// heap-owned copy (callers free their buffers right after buffering).
struct PendingMsg {
    seq: u64,
    role: u64,
    body_ptr: ptr,
    body_len: u64,
}

fn session_db_sessions_schema() -> (ptr, u64) {
    // Workaround: STR_LEN miscompiles the length of this literal (toolchain
    // bug); length is hardcoded. DDL text is fixed, 210 bytes with \n = 1 byte.
    let p = STR_PTR("#def MAX_ROWS = 1024\n#def COL_ID_STRIDE = 8 // u64\n#def COL_CREATED_MS_STRIDE = 8 // u64\n#def COL_UPDATED_MS_STRIDE = 8 // u64\n#def COL_MSG_COUNT_STRIDE = 8 // u64\n#def COL_TITLE_BLOB_STRIDE = 8 // blob_handle\n");
    let l: u64 = 210;
    return (p, l);
}

fn session_db_messages_schema() -> (ptr, u64) {
    let p = STR_PTR("#def MAX_ROWS = 65536\n#def COL_SESSION_ID_STRIDE = 8 // u64\n#def COL_SEQ_STRIDE = 8 // u64\n#def COL_ROLE_STRIDE = 8 // u64\n#def COL_BODY_BLOB_STRIDE = 8 // blob_handle\n");
    let l: u64 = 168;
    return (p, l);
}

fn session_db_root() -> (ptr, u64) {
    let rp = X_DB_ROOT_PTR();
    let rl = X_DB_ROOT_LEN();
    return (rp, rl);
}

fn session_db_table_exists(root: ptr, root_len: u64, tptr: ptr, tlen: u64) -> bool {
    let h: ptr = PTR_NULL();
    let st = sa_db_open_read_table(root, root_len, tptr, tlen, &h);
    if st != 0 {
        return false;
    };
    sa_db_close_read_table(h);
    return true;
}

fn session_db_ensure() -> bool {
    let (root, root_len) = session_db_root();
    let sn = STR_PTR("sessions");
    let snl = STR_LEN("sessions");
    if session_db_table_exists(root, root_len, sn, snl) != true {
        let info = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
        let (sp, sl) = session_db_sessions_schema();
        let st = sa_db_init_schema(root, root_len,
            STR_PTR("sessions.sadb-schema"), STR_LEN("sessions.sadb-schema"),
            sp, sl, &info);
        if st != 0 {
            println("scodex-mini: db init failed (sessions)");
            return false;
        };
    };
    let mn = STR_PTR("messages");
    let mnl = STR_LEN("messages");
    if session_db_table_exists(root, root_len, mn, mnl) != true {
        let minfo = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
        let (mp, ml) = session_db_messages_schema();
        let mst = sa_db_init_schema(root, root_len,
            STR_PTR("messages.sadb-schema"), STR_LEN("messages.sadb-schema"),
            mp, ml, &minfo);
        if mst != 0 {
            println("scodex-mini: db init failed (messages)");
            return false;
        };
    };
    let ci = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    let cst = sa_db_create_u64_pair_index(root, root_len, mn, mnl, 0, 1, 0, &ci);
    if cst != 0 {
        println("scodex-mini: db init failed (index)");
        return false;
    };
    // sessions(id) u64 index: required for get_row_u64_key/upsert_row_u64_key (else err 2).
    let si2 = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    let sst = sa_db_create_u64_index(root, root_len, sn, snl, 0, 1, &si2);
    if sst != 0 {
        println("scodex-mini: db init failed (sessions idx)");
        return false;
    };
    // Context compaction table (P0-2): append-only summaries, safe on --list.
    if compact_ensure_table(root, root_len) != true {
        return false;
    };
    return true;
}

fn session_create(title_ptr: ptr, title_len: u64) -> u64 {
    let (root, root_len) = session_db_root();
    var tlen: u64;
    tlen = title_len;
    if tlen > 40 {
        tlen = 40;
    };
    let blob_id: u64 = 0;
    let binfo = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    let bst = sa_db_blob_put(root, root_len,
        STR_PTR("sessions"), STR_LEN("sessions"),
        STR_PTR("texts"), STR_LEN("texts"),
        title_ptr, tlen, &blob_id, &binfo);
    if bst != 0 {
        println("scodex-mini: session save failed");
        return 0;
    };
    let h: ptr = PTR_NULL();
    let ost = sa_db_open_read_table(root, root_len, STR_PTR("sessions"), STR_LEN("sessions"), &h);
    if ost != 0 {
        println("scodex-mini: session save failed");
        return 0;
    };
    let mx: u64 = 0;
    let xst = sa_db_max_u64_handle(h, 0, &mx);
    sa_db_close_read_table(h);
    if xst != 0 {
        println("scodex-mini: session save failed");
        return 0;
    };
    let new_id = mx + 1;
    let now_ms = sa_time_unix_ms();
    let now_u: u64 = now_ms as u64;
    let srow = SessionRow { id: new_id, created_ms: now_u, updated_ms: now_u, msg_count: 0, title_blob: blob_id };
    let iinfo = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    let ist = sa_db_insert_row(root, root_len, STR_PTR("sessions"), STR_LEN("sessions"), &srow, 40, &iinfo);
    if ist != 0 {
        println("scodex-mini: session save failed");
        return 0;
    };
    return new_id;
}

fn session_add_message(pend: Vec<PendingMsg>, seq: u64, role: u64, body_ptr: ptr, body_len: u64) -> Vec<PendingMsg> {
    // Copy body bytes to the heap: callers free their own buffers right
    // after this returns (e.g. sa_json_buffer_free), so the pointer must
    // not escape unowned.
    let owned: ptr = PTR_NULL();
    if body_len > 0 {
        owned = X_HEAP_BUF_PTR(body_len);
        X_COPY_BYTES(owned, body_ptr, body_len);
    };
    pend.push(PendingMsg { seq: seq, role: role, body_ptr: owned, body_len: body_len });
    return pend;
}

// Persists all buffered messages for a session in two durable transactions:
// (1) one write-tx on `messages`: tx_blob_put per body + tx_insert_rows,
// committed atomically; (2) one session_bump for the sessions row.
// Empty batch is a no-op. msg_count is derived as max(seq)+1, matching the
// old per-message bump semantics. Bodies stay heap-allocated until process
// exit (consistent with the rest of this CLI).
fn session_flush_messages(session_id: u64, pend: Vec<PendingMsg>) -> bool {
    let n = pend.len();
    if n == 0 {
        return true;
    };
    let (root, root_len) = session_db_root();
    let tx: ptr = PTR_NULL();
    let tbst = sa_db_tx_begin(root, root_len,
        STR_PTR("messages"), STR_LEN("messages"), &tx);
    if tbst != 0 {
        println("scodex-mini: session save failed");
        return false;
    };
    let rows = X_HEAP_BUF_PTR(n * 32);
    let max_seq: u64 = 0;
    let i: u64 = 0;
    while i < n {
        let pm = pend[i];
        let bid: u64 = 0;
        let binfo = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
        let pst = sa_db_tx_blob_put(tx,
            STR_PTR("texts"), STR_LEN("texts"),
            pm.body_ptr, pm.body_len, &bid, &binfo);
        if pst != 0 {
            sa_db_tx_rollback(tx);
            println("scodex-mini: session save failed");
            return false;
        };
        // Pack row [session_id, seq, role, body_blob] (32 bytes).
        // Use X_ROW_PUT_U64 with absolute u64 column index (4 cols per row).
        let base = i * 4;
        X_ROW_PUT_U64(rows, base, session_id);
        let base1 = base + 1;
        X_ROW_PUT_U64(rows, base1, pm.seq);
        let base2 = base + 2;
        X_ROW_PUT_U64(rows, base2, pm.role);
        let base3 = base + 3;
        X_ROW_PUT_U64(rows, base3, bid);
        if pm.seq > max_seq {
            max_seq = pm.seq;
        };
        i = i + 1;
    }
    let iinfo = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    let ist = sa_db_tx_insert_rows(tx, rows, n * 32, n, &iinfo);
    if ist != 0 {
        sa_db_tx_rollback(tx);
        println("scodex-mini: session save failed");
        return false;
    };
    let cinfo = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    if sa_db_tx_commit(tx, &cinfo) != 0 {
        println("scodex-mini: session save failed");
        return false;
    };
    // Single bump with the final count (was: one bump per message).
    if session_bump(session_id, max_seq + 1) != true {
        return false;
    };
    return true;
}

fn session_bump(session_id: u64, msg_count: u64) -> bool {
    let (root, root_len) = session_db_root();
    let h: ptr = PTR_NULL();
    let ost = sa_db_open_read_table(root, root_len, STR_PTR("sessions"), STR_LEN("sessions"), &h);
    if ost != 0 {
        println("scodex-mini: session save failed");
        return false;
    };
    let row = SessionRow { id: 0, created_ms: 0, updated_ms: 0, msg_count: 0, title_blob: 0 };
    let gst = sa_db_get_row_u64_key_handle(h, 0, session_id, &row, 40);
    sa_db_close_read_table(h);
    if gst != 0 {
        println("scodex-mini: session save failed");
        return false;
    };
    let now_ms = sa_time_unix_ms();
    let now_u: u64 = now_ms as u64;
    let newrow = SessionRow { id: row.id, created_ms: row.created_ms, updated_ms: now_u, msg_count: msg_count, title_blob: row.title_blob };
    let inserted: u64 = 0;
    let uinfo = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    let ust = sa_db_upsert_row_u64_key(root, root_len,
        STR_PTR("sessions"), STR_LEN("sessions"),
        0, session_id, &newrow, 40, &inserted, &uinfo);
    if ust != 0 {
        println("scodex-mini: session save failed");
        return false;
    };
    return true;
}


// ---- Context compaction (P0-2) ----
// Bounds the prompt injected by --resume to cfg.compaction_budget estimated
// tokens (default 32000 via SCODEX_COMPACTION_BUDGET; SCODEX_COMPACTION=0
// disables). Short sessions that fit the budget take the old path byte for
// byte identical: no marker, no reordering.
//
// A `compactions` table stores append-only summary rows:
//   (session_id, from_seq, to_seq, created_ms, summary_blob)
// Each row covers raw messages with seq in [from_seq, to_seq). A new
// compaction only ever summarizes RAW messages — never an existing summary —
// so repeated compactions cannot degenerate into summaries of summaries.
// Raw messages are never deleted: if a summary row is lost or corrupt, the
// next resume simply re-summarizes the raw messages (safe direction, no data
// loss).

struct CompactMsg {
    seq: u64,
    role: u64,
    body_ptr: ptr,
    body_len: u64,
}

struct CompactRow {
    from_seq: u64,
    to_seq: u64,
    summary_ptr: ptr,
    summary_len: u64,
}

struct CompactionDbRow {
    session_id: u64,
    from_seq: u64,
    to_seq: u64,
    created_ms: u64,
    summary_blob: u64,
}

// Rough token estimate: ~4 bytes per token. Conservative for CJK/UTF-8,
// optimistic for base64; good enough for a budget heuristic.
fn compact_estimate_tokens(body_len: u64) -> u64 {
    // Conservative: ~3 bytes per token (CJK-heavy text), rounded up,
    // plus a fixed per-message framing overhead.
    return (body_len + 2) / 3 + 8;
}

@test "compaction token estimate"() {
    if compact_estimate_tokens(400) != 142 { panic(711); };
    if compact_estimate_tokens(3) != 9 { panic(712); };
    if compact_estimate_tokens(0) != 8 { panic(713); };
}

// Plans which raw messages to summarize: returns the cutoff index into the
// (seq-ordered) message arrays. Messages [0, cutoff) are summarized,
// [cutoff, n) are kept raw. The cutoff always lands on a turn boundary (a
// message with role 0=user or 4=user-image starts a turn), so an
// assistant/function_call/output group is never split, and at least the
// newest turn is always kept even if it alone exceeds avail.
fn compact_plan_cutoff(ests: Vec<u64>, roles: Vec<u64>, avail: u64) -> u64 {
    let n = ests.len();
    if n == 0 {
        return 0;
    };
    let starts: Vec<u64> = Vec::new();
    starts.push(0);
    let i: u64 = 1;
    while i < n {
        let r = roles[i];
        if r == 0 {
            starts.push(i);
        };
        if r == 4 {
            starts.push(i);
        };
        i = i + 1;
    }
    let nturns = starts.len();
    var acc: u64;
    acc = 0;
    var cutoff: u64;
    cutoff = starts[nturns - 1];
    var stop: bool;
    stop = false;
    var ti: u64;
    ti = nturns;
    while ti > 0 {
        if stop != true {
            let k = ti - 1;
            let s = starts[k];
            var e: u64;
            e = n;
            if k + 1 < nturns {
                e = starts[k + 1];
            };
            var test: u64;
            test = 0;
            var m: u64;
            m = s;
            while m < e {
                test = test + ests[m];
                m = m + 1;
            }
            if acc + test <= avail {
                acc = acc + test;
                cutoff = s;
            } else {
                stop = true;
            };
        };
        ti = ti - 1;
    }
    return cutoff;
}

@test "compaction cutoff planner"() {
    let ests: Vec<u64> = Vec::new();
    ests.push(100);
    ests.push(100);
    ests.push(200);
    ests.push(200);
    ests.push(300);
    let roles: Vec<u64> = Vec::new();
    roles.push(0);
    roles.push(1);
    roles.push(0);
    roles.push(1);
    roles.push(0);
    // avail 500: newest turn (300) fits; +middle turn (400) = 700 > 500.
    if compact_plan_cutoff(ests, roles, 500) != 4 { panic(721); };
    // avail huge: everything fits, nothing to summarize.
    if compact_plan_cutoff(ests, roles, 10000) != 0 { panic(722); };
    // avail 0: newest turn still kept.
    if compact_plan_cutoff(ests, roles, 0) != 4 { panic(723); };
    // function_call/output belong to the assistant turn; image starts a turn.
    let ests2: Vec<u64> = Vec::new();
    ests2.push(50);
    ests2.push(50);
    ests2.push(50);
    ests2.push(50);
    ests2.push(50);
    let roles2: Vec<u64> = Vec::new();
    roles2.push(0);
    roles2.push(2);
    roles2.push(3);
    roles2.push(1);
    roles2.push(4);
    // avail 50: newest (image) turn kept; nothing else fits.
    if compact_plan_cutoff(ests2, roles2, 50) != 4 { panic(724); };
    // avail 250: all fit.
    if compact_plan_cutoff(ests2, roles2, 250) != 0 { panic(725); };
}

fn session_db_compactions_schema() -> (ptr, u64) {
    // DDL text is fixed; STR_LEN miscompiles the length of this literal
    // (toolchain bug), so the length is hardcoded. 215 bytes incl. \n.
    let p = STR_PTR("#def MAX_ROWS = 4096\n#def COL_SESSION_ID_STRIDE = 8 // u64\n#def COL_FROM_SEQ_STRIDE = 8 // u64\n#def COL_TO_SEQ_STRIDE = 8 // u64\n#def COL_CREATED_MS_STRIDE = 8 // u64\n#def COL_SUMMARY_BLOB_STRIDE = 8 // blob_handle\n");
    let l: u64 = 215;
    return (p, l);
}

// Creates the compactions table + (session_id, from_seq) pair index when
// missing. Called from session_db_ensure; safe to run on --list (no key).
fn compact_ensure_table(root: ptr, root_len: u64) -> bool {
    let tn = STR_PTR("compactions");
    let tnl = STR_LEN("compactions");
    let h: ptr = PTR_NULL();
    let ost = sa_db_open_read_table(root, root_len, tn, tnl, &h);
    if ost == 0 {
        sa_db_close_read_table(h);
    };
    if ost != 0 {
        let info = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
        let (sp, sl) = session_db_compactions_schema();
        let st = sa_db_init_schema(root, root_len,
            STR_PTR("compactions.sadb-schema"), STR_LEN("compactions.sadb-schema"),
            sp, sl, &info);
        if st != 0 {
            println("scodex-mini: db init failed (compactions)");
            return false;
        };
    };
    let ci = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    let cst = sa_db_create_u64_pair_index(root, root_len, tn, tnl, 0, 1, 0, &ci);
    if cst != 0 {
        println("scodex-mini: db init failed (compactions index)");
        return false;
    };
    return true;
}

// Loads a session's compaction rows ordered by from_seq (the pair index on
// (session_id, from_seq) yields ascending from_seq). A corrupt row is never
// silently skipped: it aborts the load with an error; raw messages are still
// in the DB, so resume degrades to re-summarizing instead of losing data.
fn compact_load_rows(session_id: u64) -> (Vec<CompactRow>, bool) {
    let out: Vec<CompactRow> = Vec::new();
    let (root, root_len) = session_db_root();
    let tn = STR_PTR("compactions");
    let tnl = STR_LEN("compactions");
    let h: ptr = PTR_NULL();
    if sa_db_open_read_table(root, root_len, tn, tnl, &h) != 0 {
        println("scodex-mini: session db error");
        return (out, false);
    };
    let probe: u64 = 0;
    let w: u64 = 0;
    let total: u64 = 0;
    if sa_db_filter_u64_pair_key1_handle(h, 0, 1, session_id, 0, 0, &probe, 1, &w, &total) != 0 {
        println("scodex-mini: session db error");
        sa_db_close_read_table(h);
        return (out, false);
    };
    if total == 0 {
        sa_db_close_read_table(h);
        return (out, true);
    };
    let rows_ptr = X_HEAP_BUF_PTR(total * 8);
    let w2: u64 = 0;
    let total2: u64 = 0;
    if sa_db_filter_u64_pair_key1_handle(h, 0, 1, session_id, 0, total, rows_ptr, total, &w2, &total2) != 0 {
        println("scodex-mini: session db error");
        sa_db_close_read_table(h);
        return (out, false);
    };
    let store = STR_PTR("texts");
    let store_len = STR_LEN("texts");
    let i: u64 = 0;
    while i < total {
        let ri = X_ROW_GET_U64(rows_ptr, i);
        let r = CompactionDbRow { session_id: 0, from_seq: 0, to_seq: 0, created_ms: 0, summary_blob: 0 };
        if sa_db_get_row_handle(h, ri, &r, 40) != 0 {
            println("scodex-mini: corrupt compaction record (session {})", session_id);
            sa_db_close_read_table(h);
            return (out, false);
        };
        let found: u64 = 0;
        let blen: u64 = 0;
        if sa_db_blob_value_len_handle(h, store, store_len, r.summary_blob, &found, &blen) != 0 {
            println("scodex-mini: corrupt compaction record (session {})", session_id);
            sa_db_close_read_table(h);
            return (out, false);
        };
        if found != 1 {
            println("scodex-mini: corrupt compaction record (session {})", session_id);
            sa_db_close_read_table(h);
            return (out, false);
        };
        let bbuf: ptr = PTR_NULL();
        if blen > 0 {
            bbuf = X_HEAP_BUF_PTR(blen);
            let found2: u64 = 0;
            let written: u64 = 0;
            if sa_db_blob_value_copy_handle(h, store, store_len, r.summary_blob, bbuf, blen, &found2, &written) != 0 {
                println("scodex-mini: corrupt compaction record (session {})", session_id);
                sa_db_close_read_table(h);
                return (out, false);
            };
        };
        out.push(CompactRow { from_seq: r.from_seq, to_seq: r.to_seq, summary_ptr: bbuf, summary_len: blen });
        i = i + 1;
    }
    sa_db_close_read_table(h);
    return (out, true);
}

// Appends one summary row covering raw messages [from_seq, to_seq).
fn compact_store_row(session_id: u64, from_seq: u64, to_seq: u64, summary_ptr: ptr, summary_len: u64) -> bool {
    let (root, root_len) = session_db_root();
    let tn = STR_PTR("compactions");
    let tnl = STR_LEN("compactions");
    let bid: u64 = 0;
    let binfo = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    if sa_db_blob_put(root, root_len, tn, tnl,
        STR_PTR("texts"), STR_LEN("texts"),
        summary_ptr, summary_len, &bid, &binfo) != 0 {
        println("scodex-mini: compaction save failed");
        return false;
    };
    let now_ms = sa_time_unix_ms();
    let now_u: u64 = now_ms as u64;
    let row = CompactionDbRow { session_id: session_id, from_seq: from_seq, to_seq: to_seq, created_ms: now_u, summary_blob: bid };
    let iinfo = DbTableInfo { row_count: 0, segment_count: 0, epoch: 0, locked: 0 };
    if sa_db_insert_row(root, root_len, tn, tnl, &row, 40, &iinfo) != 0 {
        println("scodex-mini: compaction save failed");
        return false;
    };
    return true;
}

// Concatenates two byte strings into a fresh heap buffer.
fn compact_concat(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> (ptr, u64) {
    let total = a_len + b_len;
    if total == 0 {
        return (PTR_NULL(), 0);
    };
    let buf = X_HEAP_BUF_PTR(total);
    if a_len > 0 {
        X_COPY_BYTES(buf, a_ptr, a_len);
    };
    if b_len > 0 {
        X_COPY_BYTES(X_PTR_ADD(buf, a_len), b_ptr, b_len);
    };
    return (buf, total);
}

// Renders one message as labeled plain text for the summarization prompt.
// Tool calls keep name+args; tool outputs are truncated to 2000 bytes; image
// messages contribute their text caption only (never base64). JSON parse
// failures fall back to the raw body — nothing is silently dropped.
fn compact_render_message(role: u64, body_ptr: ptr, body_len: u64) -> (ptr, u64) {
    if role == 0 {
        return compact_concat(STR_PTR("[用户]\n"), STR_LEN("[用户]\n"), body_ptr, body_len);
    };
    if role == 1 {
        return compact_concat(STR_PTR("[助手]\n"), STR_LEN("[助手]\n"), body_ptr, body_len);
    };
    if role == 4 {
        let tk = STR_PTR("text");
        let tkl = STR_LEN("text");
        let cap = STR_PTR("[用户（图片消息）]\n");
        let capl = STR_LEN("[用户（图片消息）]\n");
        let broot = JSON_PARSE(body_ptr, body_len);
        if broot != PTR_NULL() {
            if X_OBJ_HAS(broot, tk, tkl) == true {
                let txp = X_OBJ_STR_PTR(broot, tk, tkl);
                let txl = X_OBJ_STR_LEN(broot, tk, tkl);
                if txp != PTR_NULL() {
                    return compact_concat(cap, capl, txp, txl);
                };
            };
        };
        return compact_concat(cap, capl, body_ptr, body_len);
    };
    if role == 2 {
        let nk = STR_PTR("name");
        let nkl = STR_LEN("name");
        let ak = STR_PTR("args");
        let akl = STR_LEN("args");
        let broot = JSON_PARSE(body_ptr, body_len);
        if broot != PTR_NULL() {
            if X_OBJ_HAS(broot, nk, nkl) == true {
                if X_OBJ_HAS(broot, ak, akl) == true {
                    let nmp = X_OBJ_STR_PTR(broot, nk, nkl);
                    let nml = X_OBJ_STR_LEN(broot, nk, nkl);
                    let agp = X_OBJ_STR_PTR(broot, ak, akl);
                    let agl = X_OBJ_STR_LEN(broot, ak, akl);
                    if nmp != PTR_NULL() {
                        if agp != PTR_NULL() {
                            let (h1, hl1) = compact_concat(STR_PTR("[工具调用 "), STR_LEN("[工具调用 "), nmp, nml);
                            let (h2, hl2) = compact_concat(h1, hl1, STR_PTR("]\nargs="), STR_LEN("]\nargs="));
                            return compact_concat(h2, hl2, agp, agl);
                        };
                    };
                };
            };
        };
        return compact_concat(STR_PTR("[工具调用]\n"), STR_LEN("[工具调用]\n"), body_ptr, body_len);
    };
    if role == 3 {
        let ok = STR_PTR("output");
        let okl = STR_LEN("output");
        let broot = JSON_PARSE(body_ptr, body_len);
        if broot != PTR_NULL() {
            if X_OBJ_HAS(broot, ok, okl) == true {
                let outp = X_OBJ_STR_PTR(broot, ok, okl);
                let outl = X_OBJ_STR_LEN(broot, ok, okl);
                if outp != PTR_NULL() {
                    var tl: u64;
                    tl = outl;
                    if tl > 2000 {
                        tl = 2000;
                    };
                    let (h1, hl1) = compact_concat(STR_PTR("[工具输出]\n"), STR_LEN("[工具输出]\n"), outp, tl);
                    if outl > 2000 {
                        return compact_concat(h1, hl1, STR_PTR("\n…[输出截断]"), STR_LEN("\n…[输出截断]"));
                    };
                    return (h1, hl1);
                };
            };
        };
        return compact_concat(STR_PTR("[工具输出]\n"), STR_LEN("[工具输出]\n"), body_ptr, body_len);
    };
    return compact_concat(STR_PTR("[未知角色]\n"), STR_LEN("[未知角色]\n"), body_ptr, body_len);
}

// Builds the summarization prompt: instruction header + labeled turns.
// The SCODEX_COMPACT_REQ sentinel lets test mocks recognize the request
// without touching real model traffic.
fn compact_build_prompt(msgs: Vec<CompactMsg>, count: u64) -> (ptr, u64) {
    let head = STR_PTR("SCODEX_COMPACT_REQ\n你是对话压缩器。请把下面按时间顺序排列的历史对话轮次压缩成一段简洁的中文摘要，供后续对话继续时参考。\n要求：\n1. 保留所有关键决策、结论和重要事实，一条都不要遗漏。\n2. 工具调用只保留摘要：调用了什么工具/命令、关键参数、是否成功、重要输出（错误信息必须保留）。\n3. 保留重要文件路径、用户明确提出的要求和偏好。\n4. 省略寒暄和无信息量的重复内容。\n5. 直接输出摘要正文，不要开场白，不要用代码块包裹。\n\n历史对话：\n");
    let head_len = STR_LEN("SCODEX_COMPACT_REQ\n你是对话压缩器。请把下面按时间顺序排列的历史对话轮次压缩成一段简洁的中文摘要，供后续对话继续时参考。\n要求：\n1. 保留所有关键决策、结论和重要事实，一条都不要遗漏。\n2. 工具调用只保留摘要：调用了什么工具/命令、关键参数、是否成功、重要输出（错误信息必须保留）。\n3. 保留重要文件路径、用户明确提出的要求和偏好。\n4. 省略寒暄和无信息量的重复内容。\n5. 直接输出摘要正文，不要开场白，不要用代码块包裹。\n\n历史对话：\n");
    var acc_ptr: ptr;
    acc_ptr = head;
    var acc_len: u64;
    acc_len = head_len;
    let i: u64 = 0;
    while i < count {
        let m = msgs[i];
        let (rp, rl) = compact_render_message(m.role, m.body_ptr, m.body_len);
        let (s1, sl1) = compact_concat(acc_ptr, acc_len, STR_PTR("\n---\n"), STR_LEN("\n---\n"));
        let (s2, sl2) = compact_concat(s1, sl1, rp, rl);
        acc_ptr = s2;
        acc_len = sl2;
        i = i + 1;
    }
    return (acc_ptr, acc_len);
}

// Extracts the summary text from a non-streaming model response. Returns a
// (ptr, len) borrowing the response body — the caller must heap-copy before
// freeing the HTTP response.
fn compact_extract_summary_text(api_mode: u64, body_ptr: ptr, body_len: u64) -> (ptr, u64, bool) {
    let nullp: ptr = PTR_NULL();
    let root = JSON_PARSE(body_ptr, body_len);
    if root == PTR_NULL() {
        return (nullp, 0, false);
    };
    if api_mode == 1 {
        // Chat: choices[0].message.content (string; ignores tool_calls).
        let ck = STR_PTR("choices");
        let ckl = STR_LEN("choices");
        let mk = STR_PTR("message");
        let mkl = STR_LEN("message");
        let tk = STR_PTR("content");
        let tkl = STR_LEN("content");
        if X_OBJ_HAS(root, ck, ckl) != true { return (nullp, 0, false); };
        let ch_slot: ptr = PTR_NULL();
        if sa_json_object_get(root, ck, ckl, &ch_slot) != 0 { return (nullp, 0, false); };
        let c0_slot: ptr = PTR_NULL();
        if sa_json_array_get(ch_slot, 0, &c0_slot) != 0 { return (nullp, 0, false); };
        if X_OBJ_HAS(c0_slot, mk, mkl) != true { return (nullp, 0, false); };
        let msg_slot: ptr = PTR_NULL();
        if sa_json_object_get(c0_slot, mk, mkl, &msg_slot) != 0 { return (nullp, 0, false); };
        if X_OBJ_HAS(msg_slot, tk, tkl) != true { return (nullp, 0, false); };
        let tp = X_OBJ_STR_PTR(msg_slot, tk, tkl);
        let tl = X_OBJ_STR_LEN(msg_slot, tk, tkl);
        if tp == PTR_NULL() { return (nullp, 0, false); };
        return (tp, tl, true);
    };
    // Responses: output[] item with type=="message" -> content[0].text.
    let ok = STR_PTR("output");
    let okl = STR_LEN("output");
    let tyk = STR_PTR("type");
    let tykl = STR_LEN("type");
    let ctk = STR_PTR("content");
    let ctkl = STR_LEN("content");
    let txk = STR_PTR("text");
    let txkl = STR_LEN("text");
    if X_OBJ_HAS(root, ok, okl) != true { return (nullp, 0, false); };
    let out_slot: ptr = PTR_NULL();
    if sa_json_object_get(root, ok, okl, &out_slot) != 0 { return (nullp, 0, false); };
    let cnt_slot: u64 = 0;
    if sa_json_value_count(out_slot, &cnt_slot) != 0 { return (nullp, 0, false); };
    let n = cnt_slot;
    let i: u64 = 0;
    while i < n {
        let item_slot: ptr = PTR_NULL();
        if sa_json_array_get(out_slot, i, &item_slot) == 0 {
            let item = item_slot;
            if X_OBJ_HAS(item, tyk, tykl) == true {
                let itp = X_OBJ_STR_PTR(item, tyk, tykl);
                let itl = X_OBJ_STR_LEN(item, tyk, tykl);
                if mini_model_str_eq(itp, itl, STR_PTR("message"), STR_LEN("message")) == true {
                    if X_OBJ_HAS(item, ctk, ctkl) == true {
                        let c_slot: ptr = PTR_NULL();
                        if sa_json_object_get(item, ctk, ctkl, &c_slot) == 0 {
                            let c0_slot: ptr = PTR_NULL();
                            if sa_json_array_get(c_slot, 0, &c0_slot) == 0 {
                                if X_OBJ_HAS(c0_slot, txk, txkl) == true {
                                    let tp = X_OBJ_STR_PTR(c0_slot, txk, txkl);
                                    let tl = X_OBJ_STR_LEN(c0_slot, txk, txkl);
                                    if tp != PTR_NULL() {
                                        return (tp, tl, true);
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
        i = i + 1;
    }
    return (nullp, 0, false);
}

// Sends one non-streaming summarization request. Never uses the SSE path:
// the internal summary must not leak onto the user's stdout. Returns a
// heap-owned copy of the summary text.
fn compact_summarize(url_ptr: ptr, url_len: u64, cfg: MiniConfig, prompt_ptr: ptr, prompt_len: u64) -> (ptr, u64, bool) {
    let nullp: ptr = PTR_NULL();
    let items: Vec<MiniInputItem> = Vec::new();
    items.push(mini_input_user(prompt_ptr, prompt_len));
    let json_buf = mini_model_build_request_dispatch(cfg, items, nullp, 0, nullp, 0);
    if json_buf == PTR_NULL() {
        return (nullp, 0, false);
    };
    let body_ref = sa_json_buffer_data(json_buf);
    let body_ptr: ptr = body_ref;
    let body_len = sa_json_buffer_len(json_buf);
    let resp = mini_http_post_json(url_ptr, url_len, body_ptr, body_len, cfg.api_key_ptr, cfg.api_key_len);
    if resp.ok != true {
        mini_http_response_free(resp);
        return (nullp, 0, false);
    };
    if resp.status != 200 {
        mini_http_response_free(resp);
        return (nullp, 0, false);
    };
    let (tp, tl, tok) = compact_extract_summary_text(cfg.api_mode, resp.body_ptr, resp.body_len);
    if tok != true {
        mini_http_response_free(resp);
        return (nullp, 0, false);
    };
    if tl == 0 {
        mini_http_response_free(resp);
        return (nullp, 0, false);
    };
    let (cp, cl) = compact_concat(tp, tl, nullp, 0);
    mini_http_response_free(resp);
    return (cp, cl, true);
}

// Converts one loaded message into a request item, preserving the exact
// corrupt-record diagnostics of the original resume path. Returns (item, ok);
// the item is only valid when ok is true.
fn session_compact_msg_to_item(session_id: u64, seq: u64, role: u64, bptr: ptr, blen: u64) -> (MiniInputItem, bool) {
    let dummy = mini_input_user(PTR_NULL(), 0);
    if role == 0 {
        return (mini_input_user(bptr, blen), true);
    };
    if role == 4 {
        // User image message: {"text","img","mime"} JSON blob.
        let broot4 = JSON_PARSE(bptr, blen);
        let tk = STR_PTR("text");
        let tkl = STR_LEN("text");
        let ik = STR_PTR("img");
        let ikl = STR_LEN("img");
        let mk = STR_PTR("mime");
        let mkl = STR_LEN("mime");
        if broot4 != PTR_NULL() {
            if X_OBJ_HAS(broot4, tk, tkl) == true {
                if X_OBJ_HAS(broot4, ik, ikl) == true {
                    if X_OBJ_HAS(broot4, mk, mkl) == true {
                        let txp = X_OBJ_STR_PTR(broot4, tk, tkl);
                        let txl = X_OBJ_STR_LEN(broot4, tk, tkl);
                        let imp = X_OBJ_STR_PTR(broot4, ik, ikl);
                        let iml = X_OBJ_STR_LEN(broot4, ik, ikl);
                        let mip = X_OBJ_STR_PTR(broot4, mk, mkl);
                        let mil = X_OBJ_STR_LEN(broot4, mk, mkl);
                        if txp != PTR_NULL() {
                            if imp != PTR_NULL() {
                                if mip != PTR_NULL() {
                                    if iml > 0 {
                                        if mil > 0 {
                                            return (mini_input_user_image(txp, txl, imp, iml, mip, mil), true);
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
        println("scodex-mini: corrupt image message record (session {} seq {})", session_id, seq);
        return (dummy, false);
    };
    if role == 1 {
        return (mini_input_assistant(bptr, blen), true);
    };
    if role == 2 {
        let broot = JSON_PARSE(bptr, blen);
        let ck = STR_PTR("call_id");
        let ckl = STR_LEN("call_id");
        let nk = STR_PTR("name");
        let nkl = STR_LEN("name");
        let ak = STR_PTR("args");
        let akl = STR_LEN("args");
        if broot != PTR_NULL() {
            if X_OBJ_HAS(broot, ck, ckl) == true {
                if X_OBJ_HAS(broot, nk, nkl) == true {
                    if X_OBJ_HAS(broot, ak, akl) == true {
                        let cidp = X_OBJ_STR_PTR(broot, ck, ckl);
                        let cidl = X_OBJ_STR_LEN(broot, ck, ckl);
                        let nmp = X_OBJ_STR_PTR(broot, nk, nkl);
                        let nml = X_OBJ_STR_LEN(broot, nk, nkl);
                        let agp = X_OBJ_STR_PTR(broot, ak, akl);
                        let agl = X_OBJ_STR_LEN(broot, ak, akl);
                        if cidp != PTR_NULL() {
                            if nmp != PTR_NULL() {
                                if agp != PTR_NULL() {
                                    if cidl > 0 {
                                        if nml > 0 {
                                            return (mini_input_func_call(cidp, cidl, nmp, nml, agp, agl), true);
                                        };
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
        println("scodex-mini: corrupt function_call record (session {} seq {})", session_id, seq);
        return (dummy, false);
    };
    if role == 3 {
        let broot3 = JSON_PARSE(bptr, blen);
        let ck = STR_PTR("call_id");
        let ckl = STR_LEN("call_id");
        let ok = STR_PTR("output");
        let okl = STR_LEN("output");
        if broot3 != PTR_NULL() {
            if X_OBJ_HAS(broot3, ck, ckl) == true {
                if X_OBJ_HAS(broot3, ok, okl) == true {
                    let cidp3 = X_OBJ_STR_PTR(broot3, ck, ckl);
                    let cidl3 = X_OBJ_STR_LEN(broot3, ck, ckl);
                    let outp = X_OBJ_STR_PTR(broot3, ok, okl);
                    let outl = X_OBJ_STR_LEN(broot3, ok, okl);
                    if cidp3 != PTR_NULL() {
                        if outp != PTR_NULL() {
                            if cidl3 > 0 {
                                return (mini_input_func_output(cidp3, cidl3, outp, outl), true);
                            };
                        };
                    };
                };
            };
        };
        println("scodex-mini: corrupt function_call_output record (session {} seq {})", session_id, seq);
        return (dummy, false);
    };
    println("scodex-mini: corrupt message role (session {} seq {})", session_id, seq);
    return (dummy, false);
}

// Assembles the resume prompt from loaded messages + compaction rows.
// Summaries are injected first (each explicitly marked as a compressed
// summary, never disguised as original text), then the raw messages that no
// summary covers yet. May append one new compaction row when the estimated
// prompt exceeds cfg.compaction_budget. Returns (status, next_seq, items).
fn session_resume_assemble(cfg: MiniConfig, session_id: u64, msgs: Vec<CompactMsg>) -> (u64, u64, Vec<MiniInputItem>) {
    let empty: Vec<MiniInputItem> = Vec::new();
    let n = msgs.len();
    var next_seq: u64;
    next_seq = 0;
    let qi: u64 = 0;
    while qi < n {
        let qm = msgs[qi];
        if qm.seq + 1 > next_seq {
            next_seq = qm.seq + 1;
        };
        qi = qi + 1;
    }
    // Existing summaries: base = first raw seq not yet covered.
    // When compaction is disabled, ignore summaries entirely (byte-identical
    // to the pre-compaction loader).
    let rows: Vec<CompactRow> = Vec::new();
    var base: u64;
    base = 0;
    var est_sum: u64;
    est_sum = 0;
    if cfg.compaction_enabled == true {
        let (lrows, rows_ok) = compact_load_rows(session_id);
        if rows_ok != true {
            return (1, 0, empty);
        };
        let lni: u64 = 0;
        while lni < lrows.len() {
            rows.push(lrows[lni]);
            lni = lni + 1;
        }
    };
    let nr = rows.len();
    let ri: u64 = 0;
    while ri < nr {
        let rr = rows[ri];
        if rr.to_seq > base {
            base = rr.to_seq;
        };
        est_sum = est_sum + compact_estimate_tokens(rr.summary_len);
        ri = ri + 1;
    }
    // Raw messages not yet covered by any summary (msgs are in seq order).
    let raw: Vec<CompactMsg> = Vec::new();
    let raw_est: Vec<u64> = Vec::new();
    let raw_roles: Vec<u64> = Vec::new();
    var est_raw: u64;
    est_raw = 0;
    let mi: u64 = 0;
    while mi < n {
        let mm = msgs[mi];
        if mm.seq >= base {
            raw.push(mm);
            let e = compact_estimate_tokens(mm.body_len);
            raw_est.push(e);
            raw_roles.push(mm.role);
            est_raw = est_raw + e;
        };
        mi = mi + 1;
    }
    // Trigger compaction when the estimated prompt exceeds the budget.
    var keep_from: u64;
    keep_from = 0;
    let all_rows: Vec<CompactRow> = Vec::new();
    let ar: u64 = 0;
    while ar < nr {
        all_rows.push(rows[ar]);
        ar = ar + 1;
    }
    if cfg.compaction_enabled == true {
        if est_sum + est_raw > cfg.compaction_budget {
            var avail: u64;
            avail = 0;
            if cfg.compaction_budget > est_sum + 2000 {
                avail = cfg.compaction_budget - est_sum - 2000;
            };
            let cutoff = compact_plan_cutoff(raw_est, raw_roles, avail);
            if cutoff > 0 {
                let to_seq = raw[cutoff].seq;
                let (pptr, plen) = compact_build_prompt(raw, cutoff);
                let (url_ptr, url_len) = mini_model_build_url(cfg);
                let (sptr, slen, sok) = compact_summarize(url_ptr, url_len, cfg, pptr, plen);
                var fsptr: ptr;
                fsptr = sptr;
                var fslen: u64;
                fslen = slen;
                var fsok: bool;
                fsok = sok;
                if fsok != true {
                    // One retry; then fail loudly (no silent full-history fallback).
                    let (sptr2, slen2, sok2) = compact_summarize(url_ptr, url_len, cfg, pptr, plen);
                    fsptr = sptr2;
                    fslen = slen2;
                    fsok = sok2;
                };
                if fsok != true {
                    println("scodex-mini: compaction failed: summarization request failed");
                    return (1, 0, empty);
                };
                if compact_store_row(session_id, base, to_seq, fsptr, fslen) != true {
                    return (1, 0, empty);
                };
                all_rows.push(CompactRow { from_seq: base, to_seq: to_seq, summary_ptr: fsptr, summary_len: fslen });
                keep_from = cutoff;
            };
        };
    };
    // Build items: marked summaries first, then raw messages.
    let items: Vec<MiniInputItem> = Vec::new();
    let marker = STR_PTR("[系统注：以下是压缩摘要（非原文），之后为未压缩的近期消息。]\n");
    let marker_len = STR_LEN("[系统注：以下是压缩摘要（非原文），之后为未压缩的近期消息。]\n");
    let sr: u64 = 0;
    while sr < all_rows.len() {
        let srow = all_rows[sr];
        let (mp, ml) = compact_concat(marker, marker_len, srow.summary_ptr, srow.summary_len);
        items.push(mini_input_user(mp, ml));
        sr = sr + 1;
    }
    let km: u64 = keep_from;
    while km < raw.len() {
        let rm = raw[km];
        let (it, iok) = session_compact_msg_to_item(session_id, rm.seq, rm.role, rm.body_ptr, rm.body_len);
        if iok != true {
            return (1, 0, empty);
        };
        items.push(it);
        km = km + 1;
    }
    return (0, next_seq, items);
}


// Lists all sessions: one `session id={} msgs={} updated_ms={}` line plus the
// title line per session. Does not require an API key.
fn session_list() -> i32 {
    if session_db_ensure() != true {
        return 1;
    };
    let (root, root_len) = session_db_root();
    let h: ptr = PTR_NULL();
    let ost = sa_db_open_read_table(root, root_len, STR_PTR("sessions"), STR_LEN("sessions"), &h);
    if ost != 0 {
        println("scodex-mini: session db error");
        return 1;
    };
    let sinfo = DbSnapshotInfo { row_count: 0, column_count: 0, row_bytes: 0, epoch: 0 };
    let sst = sa_db_snapshot_info_handle(h, &sinfo);
    if sst != 0 {
        println("scodex-mini: session db error");
        sa_db_close_read_table(h);
        return 1;
    };
    if sinfo.row_count == 0 {
        println("scodex-mini: no sessions");
        sa_db_close_read_table(h);
        return 0;
    };
    let store = STR_PTR("texts");
    let store_len = STR_LEN("texts");
    let i: u64 = 0;
    while i < sinfo.row_count {
        let srow = SessionRow { id: 0, created_ms: 0, updated_ms: 0, msg_count: 0, title_blob: 0 };
        let gst = sa_db_get_row_handle(h, i, &srow, 40);
        if gst != 0 {
            println("scodex-mini: session db error");
            sa_db_close_read_table(h);
            return 1;
        };
        println("session id={} msgs={} updated_ms={}", srow.id, srow.msg_count, srow.updated_ms);
        let found: u64 = 0;
        let blen: u64 = 0;
        let blst = sa_db_blob_value_len_handle(h, store, store_len, srow.title_blob, &found, &blen);
        if blst == 0 {
            if found == 1 {
                if blen > 0 {
                    let bbuf = X_HEAP_BUF_PTR(blen);
                    let found2: u64 = 0;
                    let written: u64 = 0;
                    let bcst = sa_db_blob_value_copy_handle(h, store, store_len, srow.title_blob, bbuf, blen, &found2, &written);
                    if bcst == 0 {
                        sa_print_bytes(bbuf, written);
                    };
                };
            };
        };
        println("");
        i = i + 1;
    }
    sa_db_close_read_table(h);
    return 0;
}

// Loads a session's message history into a fresh items vec for --resume.
// Returns (status, next_seq, items). status 0 = ok. Corrupt records are
// never silently skipped: they print an error and return status 1.
// NOTE: the vec is created and returned here (not taken as a param) because
// Vec values are passed by value in .sla — pushes inside a callee are not
// visible to the caller (verified with a @test probe).
fn session_resume_load(cfg: MiniConfig, session_id: u64) -> (u64, u64, Vec<MiniInputItem>) {
    let empty: Vec<MiniInputItem> = Vec::new();
    if session_db_ensure() != true {
        return (1, 0, empty);
    };
    let (root, root_len) = session_db_root();
    let h: ptr = PTR_NULL();
    let ost = sa_db_open_read_table(root, root_len, STR_PTR("sessions"), STR_LEN("sessions"), &h);
    if ost != 0 {
        println("scodex-mini: session db error");
        return (1, 0, empty);
    };
    let srow = SessionRow { id: 0, created_ms: 0, updated_ms: 0, msg_count: 0, title_blob: 0 };
    let gst = sa_db_get_row_u64_key_handle(h, 0, session_id, &srow, 40);
    sa_db_close_read_table(h);
    if gst != 0 {
        println("scodex-mini: session {} not found", session_id);
        return (1, 0, empty);
    };
    let mh: ptr = PTR_NULL();
    let ost2 = sa_db_open_read_table(root, root_len, STR_PTR("messages"), STR_LEN("messages"), &mh);
    if ost2 != 0 {
        println("scodex-mini: session db error");
        return (1, 0, empty);
    };
    // Probe with limit=0 to learn the total match count first.
    let probe: u64 = 0;
    let w: u64 = 0;
    let total: u64 = 0;
    let fst = sa_db_filter_u64_pair_key1_handle(mh, 0, 1, session_id, 0, 0, &probe, 1, &w, &total);
    if fst != 0 {
        println("scodex-mini: session db error");
        sa_db_close_read_table(mh);
        return (1, 0, empty);
    };
    // Phase 1: load raw messages. Phase 2 (session_resume_assemble) applies
    // compaction and converts to request items. Corrupt-record diagnostics
    // are preserved in session_compact_msg_to_item.
    let msgs: Vec<CompactMsg> = Vec::new();
    if total == 0 {
        sa_db_close_read_table(mh);
        return session_resume_assemble(cfg, session_id, msgs);
    };
    let rows_ptr = X_HEAP_BUF_PTR(total * 8);
    let w2: u64 = 0;
    let total2: u64 = 0;
    let fst2 = sa_db_filter_u64_pair_key1_handle(mh, 0, 1, session_id, 0, total, rows_ptr, total, &w2, &total2);
    if fst2 != 0 {
        println("scodex-mini: session db error");
        sa_db_close_read_table(mh);
        return (1, 0, empty);
    };
    let store = STR_PTR("texts");
    let store_len = STR_LEN("texts");
    let i: u64 = 0;
    while i < total {
        let ri = X_ROW_GET_U64(rows_ptr, i);
        let mrow = MessageRow { session_id: 0, seq: 0, role: 0, body_blob: 0 };
        let grst = sa_db_get_row_handle(mh, ri, &mrow, 32);
        if grst != 0 {
            println("scodex-mini: session db error");
            sa_db_close_read_table(mh);
            return (1, 0, empty);
        };
        let seq = mrow.seq;
        let role = mrow.role;
        let found: u64 = 0;
        let blen: u64 = 0;
        let blst = sa_db_blob_value_len_handle(mh, store, store_len, mrow.body_blob, &found, &blen);
        if blst != 0 {
            println("scodex-mini: session db error");
            sa_db_close_read_table(mh);
            return (1, 0, empty);
        };
        if found != 1 {
            println("scodex-mini: session db error");
            sa_db_close_read_table(mh);
            return (1, 0, empty);
        };
        let bbuf: ptr = PTR_NULL();
        if blen > 0 {
            bbuf = X_HEAP_BUF_PTR(blen);
            let found2: u64 = 0;
            let written: u64 = 0;
            let bcst = sa_db_blob_value_copy_handle(mh, store, store_len, mrow.body_blob, bbuf, blen, &found2, &written);
            if bcst != 0 {
                println("scodex-mini: session db error");
                sa_db_close_read_table(mh);
                return (1, 0, empty);
            };
        };
        msgs.push(CompactMsg { seq: seq, role: role, body_ptr: bbuf, body_len: blen });
        i = i + 1;
    }
    sa_db_close_read_table(mh);
    return session_resume_assemble(cfg, session_id, msgs);
}

// Parses native sse_turn calls JSON: [{"call_id":"...","name":"...","args":"..."}]
fn mini_sse_parse_calls_json(calls_ptr: ptr, calls_len: u64) -> Vec<MiniToolCall> {
    let out: Vec<MiniToolCall> = Vec::new();
    if calls_ptr == PTR_NULL() || calls_len == 0 {
        return out;
    };
    let root = JSON_PARSE(calls_ptr, calls_len);
    if root == PTR_NULL() {
        return out;
    };
    let nslot: u64 = 0;
    if sa_json_value_count(root, &nslot) != 0 {
        return out;
    };
    let n = nslot;
    var i: u64;
    i = 0;
    while i < n {
        let eslot: ptr = PTR_NULL();
        if sa_json_array_get(root, i, &eslot) == 0 {
            let elem = eslot;
            let call = mini_tool_call_empty();
            let cid_key = STR_PTR("call_id");
            let cid_key_len = STR_LEN("call_id");
            let nm_key = STR_PTR("name");
            let nm_key_len = STR_LEN("name");
            let ag_key = STR_PTR("args");
            let ag_key_len = STR_LEN("args");
            if X_OBJ_HAS(elem, cid_key, cid_key_len) == true {
                call.call_id_ptr = X_OBJ_STR_PTR(elem, cid_key, cid_key_len);
                call.call_id_len = X_OBJ_STR_LEN(elem, cid_key, cid_key_len);
            };
            if X_OBJ_HAS(elem, nm_key, nm_key_len) == true {
                call.name_ptr = X_OBJ_STR_PTR(elem, nm_key, nm_key_len);
                call.name_len = X_OBJ_STR_LEN(elem, nm_key, nm_key_len);
            };
            if X_OBJ_HAS(elem, ag_key, ag_key_len) == true {
                call.args_ptr = X_OBJ_STR_PTR(elem, ag_key, ag_key_len);
                call.args_len = X_OBJ_STR_LEN(elem, ag_key, ag_key_len);
            };
            out.push(call);
        };
        i = i + 1;
    }
    return out;
}
